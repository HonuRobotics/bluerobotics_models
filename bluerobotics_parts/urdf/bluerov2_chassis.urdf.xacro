<?xml version="1.0"?>
<!--
  bluerov2_chassis part macro.

  Bootstrapped from models/bluerov2_chassis/model.sdf (the artist delivery)
  by scripts/sdf_to_part.py on 2026-08-26. This file is the part: maintain
  it by hand from here on.

  The chassis is the standard (6 thruster) BlueROV2 hull as one rigid body,
  with T200 bodies and propellers as parts on the thruster_body_N and
  thruster_N slots (all fitted by default). Mass is the hull plus six T200 bodies (9.4 + 6 x
  0.3049 kg, the T200 in air mass minus its prop part), so the default
  configuration totals the reference ~11.5 kg in air. Inertia: tensor shape
  estimated from the collision geometry, scaled to that mass.

  Contract (see parts.xacro): <part>_info exports the metadata (attach,
  slots, frames, drive); <part> instantiates the link, its mounting joint
  and its slot / frame links.
  Slots other parts fit into, as frames <name>_<slot> (the thrust axis is
  thruster slot +x, or -x where the slot sets axis -1 0 0; ArduSub vectored
  frame convention preserved):
    thruster_1 .. thruster_4: vectored horizontals (1 FR ccw, 2 FL ccw,
      3 RR cw, 4 RL cw); default the matching t200 prop
    thruster_5, thruster_6: verticals (5 starboard ccw, 6 port cw)
    camera: explorehd_camera (default) or marinesitu_c3
    sonar: ping360; default none
    dvl: dvl_a50; default none
    gripper: newton_gripper or sediment_sampler; default none
    payload: payload_skid; default none
    rack: roof_rack; default none
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- The delivered chassis mesh has its origin on the commissioned datum (commissions/commission-bluerov2.yaml): the center of the frame's footprint on its bottom plane, the base_footprint of REP 105. That point is the base_footprint frame. base_link stays at the main tube's center, (-0.013605, 0, 0.187846) from the datum, so the visual is placed by the opposite offset: gz-sim's Hydrodynamics samples the link origin's velocity but applies its wrench at the CoM, and with base_link on the datum, 0.19 m below the CoM, roll couples into sway (the axis test measured sway 31 degrees off axis).

       The thruster_N and thruster_body_N poses are taken from the Blender assembly bluerov2_chassis.blend (the chassis file with t200_thruster, t200_prop_cw and t200_prop_ccw linked in): each instance's translation and rotation relative to the untransformed chassis, mapped from Blender axes to these (x = -Blender y, y = Blender x, z = Blender z) and moved by the datum offset above. A body and its prop share one pose, as their datums are the same point.

       Two corrections keep each thruster's positive thrust where ArduSub's Vectored frame puts it (AP_Motors6DOF.cpp, SUB_FRAME_VECTORED). The four horizontals are turned 90 degrees about z from the assembly, so +x lies along ArduSub's direction for that motor (1 aft starboard, 2 aft port, 3 fore starboard, 4 fore port); in the assembly they face the other diagonal, which is open with the modeler. The two verticals face up in the assembly, so their prop slots spin the occupant about -1 0 0 and positive thrust pushes down, as ArduSub's throttle factor of -1 expects.

       The camera, sonar, dvl, gripper, payload and rack positions and the inertial origin predate the assembly. The collisions were checked against the new chassis in Gazebo. Accessory visuals are out of scope: the camera, sonar and dvl parts carry no visual and work from their frames, and the gripper (subsea manipulation) is not yet in scope.

       The imu frame is where the flight controller senses attitude. Declared
       as a frame rather than a part because nothing about its mass or
       appearance matters, but simulation and TF have to agree on where it is.
       The position is a placeholder at the chassis origin: the real offset
       inside the enclosure has not been measured, and the lever arm only
       starts to matter once accelerations are compared against a real ROV. -->
  <xacro:macro name="bluerov2_chassis_info">
    <xacro:property name="part_info" scope="parent" value="${dict(
        attach='0 0 0',
        slots=dict(
            thruster_1=dict(xyz='0.156505 -0.091 -0.059546', rpy='0 3.1416 0.7854', accepts=['t200_prop_ccw'], default='t200_prop_ccw', collision=False),
            thruster_2=dict(xyz='0.156505 0.091 -0.059546', rpy='0 3.1416 -0.7854', accepts=['t200_prop_ccw'], default='t200_prop_ccw', collision=False),
            thruster_3=dict(xyz='-0.144495 -0.0895 -0.059546', rpy='-3.1416 0 -0.7854', accepts=['t200_prop_cw'], default='t200_prop_cw', collision=False),
            thruster_4=dict(xyz='-0.144495 0.0895 -0.059546', rpy='-3.1416 0 0.7854', accepts=['t200_prop_cw'], default='t200_prop_cw', collision=False),
            thruster_5=dict(xyz='0.016805 -0.111 0.001954', rpy='-1.5708 -1.5708 0', accepts=['t200_prop_ccw'], default='t200_prop_ccw', axis='-1 0 0', collision=False),
            thruster_6=dict(xyz='0.013905 0.111 -0.004746', rpy='1.5708 -1.5708 0', accepts=['t200_prop_cw'], default='t200_prop_cw', axis='-1 0 0', collision=False),
            camera=dict(xyz='0.22 0 0.05', rpy='0 0 0', accepts=['explorehd_camera', 'marinesitu_c3'], default='explorehd_camera'),
            sonar=dict(xyz='0.16 0 0.13', rpy='0 0 0', accepts=['ping360'], default='none'),
            dvl=dict(xyz='-0.12 0 -0.14', rpy='0 0 0', accepts=['dvl_a50'], default='none'),
            gripper=dict(xyz='0.28 0 -0.08', rpy='0 0 0', accepts=['newton_gripper', 'sediment_sampler'], default='none'),
            payload=dict(xyz='0 0 -0.17', rpy='0 0 0', accepts=['payload_skid'], default='none'),
            rack=dict(xyz='0 0 0.17', rpy='0 0 0', accepts=['roof_rack'], default='none'),
            thruster_body_1=dict(xyz='0.156505 -0.091 -0.059546', rpy='0 3.1416 0.7854', accepts=['t200_thruster'], default='t200_thruster', collision=False),
            thruster_body_2=dict(xyz='0.156505 0.091 -0.059546', rpy='0 3.1416 -0.7854', accepts=['t200_thruster'], default='t200_thruster', collision=False),
            thruster_body_3=dict(xyz='-0.144495 -0.0895 -0.059546', rpy='-3.1416 0 -0.7854', accepts=['t200_thruster'], default='t200_thruster', collision=False),
            thruster_body_4=dict(xyz='-0.144495 0.0895 -0.059546', rpy='-3.1416 0 0.7854', accepts=['t200_thruster'], default='t200_thruster', collision=False),
            thruster_body_5=dict(xyz='0.016805 -0.111 0.001954', rpy='-1.5708 -1.5708 0', accepts=['t200_thruster'], default='t200_thruster', collision=False),
            thruster_body_6=dict(xyz='0.013905 0.111 -0.004746', rpy='1.5708 -1.5708 0', accepts=['t200_thruster'], default='t200_thruster', collision=False),
        ),
        frames=dict(
            imu=dict(xyz='0 0 0', rpy='0 0 0'),
            footprint=dict(xyz='0.013605 0 -0.187846', rpy='0 0 0', link='base_footprint'),
        ))}"/>
  </xacro:macro>

  <xacro:macro name="bluerov2_chassis"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='1 0 0'">
    <xacro:bluerov2_chassis_info/>

    <link name="${name}">
      <inertial>
        <!-- CoM height hand tuned to the reference vehicle (+0.011 m,
             slightly above the thruster line so forward thrust pitches
             gently nose down); the bootstrap estimate from the collision
             volumes put it 3 cm low, which made surge climb. -->
        <origin xyz="0.00979373 -0.000225576 0.011" rpy="0 0 0"/>
        <!-- Chosen so the assembled vehicle matches Blue Robotics' published
             weight in air: docs/vehicles/bluerov2/parameters.md, Mass. -->
        <mass value="9.36"/>
        <!-- Bare hull: the T200 bodies and props are parts on the
             thruster_body / thruster slots. Tensor scaled to this mass. -->
        <inertia ixx="1.399298e-01" ixy="-5.670210e-06" ixz="-5.037078e-04"
                 iyy="1.743709e-01" iyz="2.066992e-05"
                 izz="2.209201e-01"/>
      </inertial>
      <xacro:part_visual mesh="package://bluerobotics_parts/models/bluerov2_chassis/bluerov2_chassis_visual.glb" xyz="0.013605 0 -0.187846" axes="gltf"/>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="0.009119 0 0" rpy="-0 1.5708 0"/>
          <geometry>
            <cylinder radius="0.057041" length="0.355013"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.010901 0 -0.114987" rpy="-0 1.5708 0"/>
          <geometry>
            <cylinder radius="0.050417" length="0.290967"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.143232 -0.109491 0.019975" rpy="0 0 0"/>
          <geometry>
            <box size="0.163831 0.100479 0.085132"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.143232 0.108931 0.019975" rpy="0 0 0"/>
          <geometry>
            <box size="0.163831 0.100479 0.085132"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="-0.115357 -0.109491 0.019975" rpy="0 0 0"/>
          <geometry>
            <box size="0.166789 0.100479 0.085132"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="-0.115357 0.108931 0.019975" rpy="0 0 0"/>
          <geometry>
            <box size="0.166789 0.100479 0.085132"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.011554 0 -0.17038" rpy="0 0 0"/>
          <geometry>
            <box size="0.249045 0.318974 0.01207"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.002147 -0.162625 -0.056151" rpy="-0 1.5708 0"/>
          <geometry>
            <box size="0.242382 0.011872 0.425088"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.002147 0.161151 -0.056151" rpy="-0 1.5708 0"/>
          <geometry>
            <box size="0.242382 0.011872 0.425088"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="${part_info['attach']}"/>
    <xacro:part_slots name="${name}" items="${list(part_info['slots'].items())}"/>
    <xacro:part_frames name="${name}" items="${list(part_info['frames'].items())}"
                       root="${parent == ''}"/>

  </xacro:macro>

</robot>
