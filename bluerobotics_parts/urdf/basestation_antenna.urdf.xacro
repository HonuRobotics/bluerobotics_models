<?xml version="1.0"?>
<!--
  basestation_antenna part macro.

  Bootstrapped from models/basestation_antenna/model.sdf by scripts/sdf_to_part.py on
  2026-08-21. This file is the part: maintain it by hand from here on.

  Inertia: estimated from the delivered collision geometry at 1000 kg/m^3 (SDF auto inertia); replace with measured values.

  Contract (see parts.xacro): <part>_info exports the metadata (attach,
  axis, slots, frames); <part> instantiates the link, its mounting joint
  and its slot / frame links.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="basestation_antenna_info">
    <xacro:property name="part_info" scope="parent" value="${dict(
        attach='0 0 0',
        axis='1 0 0',
        slots=dict(
        ),
        frames=dict(
        ))}"/>
  </xacro:macro>

  <xacro:macro name="basestation_antenna"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='1 0 0'">
    <xacro:basestation_antenna_info/>

    <link name="${name}">
      <inertial>
        <origin xyz="0 -6.4e-05 -0.0119461" rpy="0 0 0"/>
        <mass value="0.89204"/>
        <inertia ixx="0.0651018" ixy="0" ixz="0"
                 iyy="0.0648489" iyz="0"
                 izz="0.00173301"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://bluerobotics_parts/models/basestation_antenna/basestation_antenna.visual.glb"/>
        </geometry>
      </visual>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="0 -6.4e-05 -0.165655" rpy="0 -0 0"/>
          <geometry>
            <box size="0.120973 0.140125 0.035479"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0 -6.4e-05 0.30614" rpy="0 -0 0"/>
          <geometry>
            <box size="0.016528 0.019144 0.918495"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="${part_info['attach']}"/>
    <xacro:part_slots name="${name}" items="${list(part_info['slots'].items())}"/>
    <xacro:part_frames name="${name}" items="${list(part_info['frames'].items())}"/>

  </xacro:macro>

</robot>
