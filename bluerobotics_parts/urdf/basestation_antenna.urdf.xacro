<?xml version="1.0"?>
<!--
  basestation_antenna part macro. GENERATED FILE, DO NOT EDIT.

  Written by scripts/import_part.py from models/basestation_antenna/model.sdf (the
  modeler delivery) and models/basestation_antenna/basestation_antenna.yaml (measured values and
  mounts); rerun the import to change anything here.

  Inertia: auto inertia from the delivered collision geometry at 1000 kg/m^3.

  Macro contract: name parent xyz rpy collision, plus joint (fixed by
  default) and axis for parts that spin. parent="" emits the link alone,
  for the part that serves as the assembly root.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="basestation_antenna"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='0 0 1'">

    <link name="${name}">
      <inertial>
        <origin xyz="0 -6.4e-05 -0.0119461" rpy="0 0 0"/>
        <mass value="0.89204"/>
        <inertia ixx="0.0651018" ixy="0" ixz="0"
                 iyy="0.0648489" iyz="0"
                 izz="0.00173301"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://bluerobotics_parts/models/basestation_antenna/basestation_antenna.visual.glb"/>
        </geometry>
      </visual>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="0 -6.4e-05 -0.165655" rpy="0 -0 0"/>
          <geometry>
            <box size="0.120973 0.140125 0.035479"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0 -6.4e-05 0.30614" rpy="0 -0 0"/>
          <geometry>
            <box size="0.016528 0.019144 0.918495"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:if value="${parent != ''}">
      <joint name="${name}_joint" type="${joint}">
        <parent link="${parent}"/>
        <child link="${name}"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <xacro:if value="${joint != 'fixed'}">
          <axis xyz="${axis}"/>
        </xacro:if>
      </joint>
    </xacro:if>

  </xacro:macro>

</robot>
