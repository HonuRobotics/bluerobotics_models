<?xml version="1.0"?>
<!--
  Assembly dispatcher: builds a vehicle from a parts list.

  A vehicle description calls

      <xacro:include filename="$(find bluerobotics_parts)/urdf/assembly.xacro"/>
      <xacro:assemble base="${cfg['base']}" parts="${cfg['parts']}"/>

  with a config like

      base: {type: blueboat_chassis, name: base_link, collision: false}
      parts:
        - {type: m200_weedless_prop_cw, name: prop_stbd, mount: motor_stbd, joint: continuous}
        - {type: blueboat_antenna_mast, name: mast, mount: mast_socket}
        - {type: ping_singlebeam, name: ping, parent: ping_mount, mount: sensor}
        - {type: explorehd_camera, name: cam, xyz: "0.3 0 0.2", rpy: "0 0 0"}

  The base part is the assembly root: its link IS the named root link (no
  joint). Every other entry is one part instance. Where it goes is either a
  socket of its parent (mount: the socket name; the parent defaults to the
  base link) or an explicit pose (xyz/rpy) relative to the parent link. A
  part that spins takes joint: continuous about the axis its macro declares
  (or an explicit axis:).

  Sockets are frames the part macros themselves emit, named
  <instance>_<socket>; mounting is nothing more than parenting the child to
  that frame. The child's attach offset is handled inside its own macro.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find bluerobotics_parts)/urdf/parts.xacro"/>

  <xacro:macro name="place_part" params="item">
    <xacro:property name="ptype" value="${item['type']}"/>
    <xacro:property name="parent" value="${item.get('parent', 'base_link')}"/>
    <xacro:property name="at" value="${parent + '_' + item['mount'] if 'mount' in item else parent}"/>
    <xacro:property name="xyz" value="${item.get('xyz', '0 0 0')}"/>
    <xacro:property name="rpy" value="${item.get('rpy', '0 0 0')}"/>
    <xacro:property name="col" value="${item.get('collision', True)}"/>
    <xacro:property name="joint" value="${item.get('joint', 'fixed')}"/>
    <xacro:if value="${'axis' in item}">
      <xacro:call macro="${ptype}" name="${item['name']}" parent="${at}"
                  xyz="${xyz}" rpy="${rpy}" collision="${col}" joint="${joint}"
                  axis="${item['axis']}"/>
    </xacro:if>
    <xacro:unless value="${'axis' in item}">
      <xacro:call macro="${ptype}" name="${item['name']}" parent="${at}"
                  xyz="${xyz}" rpy="${rpy}" collision="${col}" joint="${joint}"/>
    </xacro:unless>
  </xacro:macro>

  <!-- xacro has no loop; recurse over the list. -->
  <xacro:macro name="mount_parts" params="items">
    <xacro:if value="${len(items) > 0}">
      <xacro:place_part item="${items[0]}"/>
      <xacro:mount_parts items="${items[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="assemble" params="base parts">
    <xacro:call macro="${base['type']}" name="${base.get('name', 'base_link')}" parent=""
                collision="${base.get('collision', True)}"/>
    <xacro:mount_parts items="${parts}"/>
  </xacro:macro>

</robot>
