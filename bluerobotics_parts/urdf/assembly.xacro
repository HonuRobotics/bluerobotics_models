<?xml version="1.0"?>
<!--
  Assembly dispatcher: builds a vehicle from a config and the parts' own
  slot tables.

  A vehicle description calls

      <xacro:include filename="$(find bluerobotics_parts)/urdf/assembly.xacro"/>
      <xacro:assemble base="${cfg['base']}" parts="${cfg.get('parts') or []}"
                      slots="${cfg.get('slots') or []}"/>

  with a config like

      base: {type: blueboat_chassis, name: base_link}
      parts:
        - {slot: motor_port, type: t200_prop_ccw}          # another option for a slot
        - {slot: ping_mount, type: none}                   # leave a slot empty
        - {slot: mast, type: blueboat_antenna_mast}        # fill a slot that has no default
        - {slot: ping, of: ping_mount, type: ping_singlebeam, topic: sonar}   # a slot of another part
        - {type: explorehd_camera, name: cam, xyz: "0.3 0 0.2", rpy: "0 0 0"}  # free placement
      slots:
        - {of: base_link, name: gopro, xyz: "0.45 0 0.2", accepts: [explorehd_camera]}

  How it resolves:

  * The base part is the root (its link is the named root link, no joint).
  * Every slot of every part in the assembly fills itself with the slot's
    default, recursively (a bracket brings its sensor), unless the config
    has an entry for that slot: `type:` picks another option (it must be in
    the slot's accepts list), `type: none` leaves it empty. An entry names
    the slot, and `of:` the instance carrying it (default: the base). The
    occupant's instance name defaults to the slot name. (The key is `of`,
    not `on`: a bare `on` is a YAML boolean and would read as `true`.)
  * Entries without slot: are free placements: type, name, xyz/rpy relative
    to parent (default: the base). Their slots fill too.
  * The occupant's joint is the entry's `joint:`, else the slot's, else the
    part's nature: a propeller (a part with a `drive` table) turns on a
    continuous joint, anything else is fixed.
  * `slots:` declares ad hoc slots on any instance, usable like the part's
    own (accepts and default work the same).
  * Mistakes the expansion can see fail it loudly: an unknown slot on the
    base, a type a slot does not accept, a slot configured twice, a bare
    `on:` key. An unknown part type fails as "unknown macro name". What
    xacro cannot see across the recursion (an entry or ad hoc slot whose
    `of:` or `slot:` matches nothing deeper down, two instances with the
    same name, an unknown key) is caught by bluerobotics_parts.assembly.check
    from the manifest below; the vehicle builds and launches run it.

  The manifest: every instance is recorded as <assembly_part type name
  parent/> and every slot visited as <assembly_slot of name/>, URDF
  extension elements urdfdom and Gazebo ignore, so tooling downstream (the
  Gazebo composition, the bridge generator, the config check) knows the
  resolved assembly without re-resolving anything. `manifest:=false` turns
  the records off for outputs that are not URDF.

  The emitter is pluggable: `emit` names the macro called per instance
  (default emit_part: the part macro), `emit_slot` the one called per ad hoc
  slot (default part_slot). Emitters receive the part's `info` table, so a
  simulator can place a sensor at a declared frame or drive a propeller.
  blueboat_gazebo runs the same resolution with such emitters, so the
  composed model can never disagree with the URDF about which parts are
  fitted.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find bluerobotics_parts)/urdf/parts.xacro"/>

  <!-- Loud failure: xacro.error raises with the message when the condition
       is evaluated (an unused property would be evaluated lazily and never
       raise; an if condition is evaluated on the spot). -->
  <xacro:macro name="assembly_fail" params="message">
    <xacro:if value="${xacro.error('ASSEMBLY ERROR: ' + message)}"/>
  </xacro:macro>

  <!-- part_info of a part type, exported into the caller's scope. -->
  <xacro:macro name="part_info_of" params="ptype">
    <xacro:call macro="${ptype}_info"/>
    <xacro:property name="part_info" scope="parent" value="${part_info}"/>
  </xacro:macro>

  <!-- Default emitter: the part macro itself. -->
  <xacro:macro name="emit_part" params="ptype name parent xyz rpy collision joint axis info">
    <xacro:if value="${axis == ''}">
      <xacro:call macro="${ptype}" name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                  collision="${collision}" joint="${joint}"/>
    </xacro:if>
    <xacro:unless value="${axis == ''}">
      <xacro:call macro="${ptype}" name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                  collision="${collision}" joint="${joint}" axis="${axis}"/>
    </xacro:unless>
  </xacro:macro>

  <!-- Ad hoc slots declared by the config on one instance. -->
  <xacro:macro name="adhoc_slots" params="inst items emit_slot">
    <xacro:if value="${len(items) > 0}">
      <xacro:call macro="${emit_slot}" name="${inst}_${items[0]['name']}" parent="${inst}"
                  xyz="${items[0]['xyz']}" rpy="${items[0].get('rpy', '0 0 0')}"/>
      <xacro:adhoc_slots inst="${inst}" items="${items[1:]}" emit_slot="${emit_slot}"/>
    </xacro:if>
  </xacro:macro>

  <!-- One slot of one instance: config entry, else the slot default. -->
  <xacro:macro name="fill_slot" params="inst slot spec entries adhoc emit emit_slot">
    <xacro:if value="${manifest}">
      <assembly_slot of="${inst}" name="${slot}"/>
    </xacro:if>
    <xacro:property name="matches"
                    value="${[e for e in entries if e.get('slot') == slot and e.get('of', base_name) == inst]}"/>
    <xacro:if value="${len(matches) > 1}">
      <xacro:assembly_fail message="slot '${slot}' of '${inst}' is configured ${len(matches)} times"/>
    </xacro:if>
    <xacro:property name="entry" value="${matches[0] if matches else dict()}"/>
    <xacro:property name="chosen" value="${entry.get('type', spec.get('default', 'none'))}"/>
    <xacro:if value="${chosen != 'none'}">
      <xacro:if value="${'accepts' in spec and chosen not in spec['accepts']}">
        <xacro:assembly_fail message="'${chosen}' does not fit slot '${slot}' of '${inst}' (accepts ${spec['accepts']})"/>
      </xacro:if>
      <xacro:place_part ptype="${chosen}" name="${entry.get('name', slot)}" parent="${inst}_${slot}"
                        xyz="${entry.get('xyz', '0 0 0')}" rpy="${entry.get('rpy', '0 0 0')}"
                        collision="${entry.get('collision', True)}"
                        joint="${entry.get('joint', spec.get('joint', ''))}"
                        axis="${entry.get('axis', '')}"
                        entries="${entries}" adhoc="${adhoc}" emit="${emit}" emit_slot="${emit_slot}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="fill_slots" params="inst items entries adhoc emit emit_slot">
    <xacro:if value="${len(items) > 0}">
      <xacro:fill_slot inst="${inst}" slot="${items[0][0]}" spec="${items[0][1]}"
                       entries="${entries}" adhoc="${adhoc}" emit="${emit}" emit_slot="${emit_slot}"/>
      <xacro:fill_slots inst="${inst}" items="${items[1:]}"
                        entries="${entries}" adhoc="${adhoc}" emit="${emit}" emit_slot="${emit_slot}"/>
    </xacro:if>
  </xacro:macro>

  <!-- Instantiate a part, then its slots: the part's own and the ad hoc
       ones the config put on this instance. joint "" means unspecified by
       the entry and the slot: a part that drives (a propeller) then turns
       on a continuous joint, anything else is fixed. -->
  <xacro:macro name="place_part"
               params="ptype name parent xyz rpy collision joint axis entries adhoc emit emit_slot">
    <xacro:part_info_of ptype="${ptype}"/>
    <xacro:property name="joint_type"
                    value="${joint if joint != '' else ('continuous' if 'drive' in part_info else 'fixed')}"/>
    <xacro:if value="${manifest}">
      <assembly_part type="${ptype}" name="${name}" parent="${parent}"/>
    </xacro:if>
    <xacro:call macro="${emit}" ptype="${ptype}" name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                collision="${collision}" joint="${joint_type}" axis="${axis}" info="${part_info}"/>
    <xacro:property name="mine" value="${[s for s in adhoc if s.get('of', base_name) == name]}"/>
    <xacro:adhoc_slots inst="${name}" items="${mine}" emit_slot="${emit_slot}"/>
    <xacro:fill_slots inst="${name}"
                      items="${list(part_info['slots'].items()) + [(s['name'], s) for s in mine]}"
                      entries="${entries}" adhoc="${adhoc}" emit="${emit}" emit_slot="${emit_slot}"/>
  </xacro:macro>

  <!-- Free placements: explicit pose relative to a parent link. -->
  <xacro:macro name="place_free" params="items entries adhoc emit emit_slot">
    <xacro:if value="${len(items) > 0}">
      <xacro:property name="it" value="${items[0]}"/>
      <xacro:if value="${'name' not in it or 'xyz' not in it}">
        <xacro:assembly_fail message="free placed part ${it} needs name and xyz (or a slot)"/>
      </xacro:if>
      <xacro:if value="${it.get('type', 'none') != 'none'}">
        <xacro:place_part ptype="${it['type']}" name="${it['name']}" parent="${it.get('parent', base_name)}"
                          xyz="${it['xyz']}" rpy="${it.get('rpy', '0 0 0')}"
                          collision="${it.get('collision', True)}" joint="${it.get('joint', '')}"
                          axis="${it.get('axis', '')}"
                          entries="${entries}" adhoc="${adhoc}" emit="${emit}" emit_slot="${emit_slot}"/>
      </xacro:if>
      <xacro:place_free items="${items[1:]}" entries="${entries}" adhoc="${adhoc}"
                        emit="${emit}" emit_slot="${emit_slot}"/>
    </xacro:if>
  </xacro:macro>

  <!-- Slot entries on the base must name a slot the base (or the config)
       declares; entries on deeper instances are checked when reached. -->
  <xacro:macro name="check_base_slots" params="items known">
    <xacro:if value="${len(items) > 0}">
      <xacro:if value="${items[0].get('of', base_name) == base_name and items[0]['slot'] not in known}">
        <xacro:assembly_fail message="unknown slot '${items[0]['slot']}' on '${base_name}' (known: ${known})"/>
      </xacro:if>
      <xacro:check_base_slots items="${items[1:]}" known="${known}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="assemble"
               params="base parts slots:='' emit:=emit_part emit_slot:=part_slot manifest:=true">
    <xacro:property name="base_name" value="${base.get('name', 'base_link')}"/>
    <xacro:property name="adhoc" value="${slots if slots else []}"/>
    <!-- A bare `on:` key parses as the YAML boolean true; the key is `of:`. -->
    <xacro:if value="${len([e for e in list(parts) + list(adhoc) if True in e]) > 0}">
      <xacro:assembly_fail message="an entry has a bare 'on:' key, which YAML reads as true; the key is 'of:'"/>
    </xacro:if>
    <xacro:property name="slot_entries" value="${[p for p in parts if 'slot' in p]}"/>
    <xacro:property name="free_entries" value="${[p for p in parts if 'slot' not in p]}"/>
    <xacro:part_info_of ptype="${base['type']}"/>
    <xacro:check_base_slots items="${slot_entries}"
                            known="${list(part_info['slots'].keys()) + [s['name'] for s in adhoc if s.get('of', base_name) == base_name]}"/>
    <xacro:place_part ptype="${base['type']}" name="${base_name}" parent="" xyz="0 0 0" rpy="0 0 0"
                      collision="${base.get('collision', True)}" joint="fixed" axis=""
                      entries="${slot_entries}" adhoc="${adhoc}" emit="${emit}" emit_slot="${emit_slot}"/>
    <xacro:place_free items="${free_entries}" entries="${slot_entries}" adhoc="${adhoc}"
                      emit="${emit}" emit_slot="${emit_slot}"/>
  </xacro:macro>

</robot>
