<?xml version="1.0"?>
<!--
  ping_singlebeam part macro.

  Bootstrapped from models/ping_singlebeam/model.sdf by scripts/sdf_to_part.py on
  2026-08-21. This file is the part: maintain it by hand from here on.

  Inertia: estimated from the delivered collision geometry at 1000 kg/m^3 (SDF auto inertia); replace with measured values.

  Contract (see parts.xacro): <part>_info exports the metadata (attach,
  axis, slots, frames); <part> instantiates the link, its mounting joint
  and its slot / frame links.
  Reference frames, as <name>_<frame>: beam
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="ping_singlebeam_info">
    <xacro:property name="part_info" scope="parent" value="${dict(
        attach='0 0 0',
        axis='1 0 0',
        slots=dict(
        ),
        frames=dict(
            beam=dict(xyz='0 0 -0.044', rpy='0 0 0'),
        ))}"/>
  </xacro:macro>

  <xacro:macro name="ping_singlebeam"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='1 0 0'">
    <xacro:ping_singlebeam_info/>

    <link name="${name}">
      <inertial>
        <origin xyz="-1e-06 -0.000802169 0.000201108" rpy="0 0 0"/>
        <mass value="0.0754089"/>
        <inertia ixx="2.31894e-05" ixy="0" ixz="0"
                 iyy="2.41653e-05" iyz="-3.73701e-07"
                 izz="2.02698e-05"/>
      </inertial>
      <xacro:part_visual mesh="package://bluerobotics_parts/models/ping_singlebeam/ping_singlebeam.visual.glb"/>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="-1e-06 -0.000647 0.001365" rpy="1.5708 -0 0"/>
          <geometry>
            <cylinder radius="0.024141" length="0.039739"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="-1e-06 -0.00506 -0.031736" rpy="0 -0 0"/>
          <geometry>
            <cylinder radius="0.005802" length="0.025072"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="${part_info['attach']}"/>
    <xacro:part_slots name="${name}" items="${list(part_info['slots'].items())}"/>
    <xacro:part_frames name="${name}" items="${list(part_info['frames'].items())}"/>

  </xacro:macro>

</robot>
