<?xml version="1.0"?>
<!--
  ping_singlebeam part macro. GENERATED FILE, DO NOT EDIT.

  Written by scripts/import_part.py from models/ping_singlebeam/model.sdf (the
  modeler delivery) and models/ping_singlebeam/ping_singlebeam.yaml (measured values and
  mounts); rerun the import to change anything here.

  Inertia: auto inertia from the delivered collision geometry at 1000 kg/m^3.

  Macro contract: name parent xyz rpy collision, plus joint (fixed by
  default) and axis for parts that spin. parent="" emits the link alone,
  for the part that serves as the assembly root.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="ping_singlebeam"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='0 0 1'">

    <link name="${name}">
      <inertial>
        <origin xyz="-1e-06 -0.000802169 0.000201108" rpy="0 0 0"/>
        <mass value="0.0754089"/>
        <inertia ixx="2.31894e-05" ixy="0" ixz="0"
                 iyy="2.41653e-05" iyz="-3.73701e-07"
                 izz="2.02698e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://bluerobotics_parts/models/ping_singlebeam/ping_singlebeam.visual.glb"/>
        </geometry>
      </visual>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="-1e-06 -0.000647 0.001365" rpy="1.5708 -0 0"/>
          <geometry>
            <cylinder radius="0.024141" length="0.039739"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="-1e-06 -0.00506 -0.031736" rpy="0 -0 0"/>
          <geometry>
            <cylinder radius="0.005802" length="0.025072"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:if value="${parent != ''}">
      <joint name="${name}_joint" type="${joint}">
        <parent link="${parent}"/>
        <child link="${name}"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <xacro:if value="${joint != 'fixed'}">
          <axis xyz="${axis}"/>
        </xacro:if>
      </joint>
    </xacro:if>

  </xacro:macro>

</robot>
