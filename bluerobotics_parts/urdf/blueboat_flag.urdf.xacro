<?xml version="1.0"?>
<!--
  blueboat_flag part macro.

  Bootstrapped from models/blueboat_flag/model.sdf by scripts/sdf_to_part.py on
  2026-08-21. This file is the part: maintain it by hand from here on.

  Inertia: estimated from the delivered collision geometry at 1000 kg/m^3 (SDF auto inertia); replace with measured values.

  Contract (see parts.xacro): <part>_info exports the metadata (attach,
  slots, frames, drive); <part> instantiates the link, its mounting joint
  and its slot / frame links.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="blueboat_flag_info">
    <xacro:property name="part_info" scope="parent" value="${dict(
        attach='0 0 -0.515',
        slots=dict(
        ),
        frames=dict(
        ))}"/>
  </xacro:macro>

  <xacro:macro name="blueboat_flag"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='1 0 0'">
    <xacro:blueboat_flag_info/>

    <link name="${name}">
      <inertial>
        <origin xyz="0 -0.000467 -0.013148" rpy="0 0 0"/>
        <mass value="0.0216994"/>
        <inertia ixx="0.00178956" ixy="0" ixz="0"
                 iyy="0.00178956" iyz="0"
                 izz="7.53318e-08"/>
      </inertial>
      <xacro:part_visual mesh="package://bluerobotics_parts/models/blueboat_flag/blueboat_flag.visual.glb"/>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="0 -0.000467 -0.013148" rpy="0 -0 0"/>
          <geometry>
            <cylinder radius="0.002635" length="0.9948"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="${part_info['attach']}"/>
    <xacro:part_slots name="${name}" items="${list(part_info['slots'].items())}"/>
    <xacro:part_frames name="${name}" items="${list(part_info['frames'].items())}"/>

  </xacro:macro>

</robot>
