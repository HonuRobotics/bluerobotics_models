<?xml version="1.0"?>
<!--
  t200_prop_ccw part macro.

  Bootstrapped from models/t200_prop_ccw/model.sdf by scripts/sdf_to_part.py on
  2026-08-21. This file is the part: maintain it by hand from here on.

  Inertia: estimated from the delivered collision geometry at 1000 kg/m^3 (SDF auto inertia); replace with measured values.

  Drive: T200 16 V endpoints and prop diameter as placeholders for every
  propeller option; replace with measured values for this prop.

  Contract (see parts.xacro): <part>_info exports the metadata (attach,
  slots, frames, drive); <part> instantiates the link, its mounting joint
  and its slot / frame links.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="t200_prop_ccw_info">
    <xacro:property name="part_info" scope="parent" value="${dict(
        attach='0 0 0',
        slots=dict(
        ),
        frames=dict(
        ),
        drive=dict(diameter=0.076, max_thrust=51.5, min_thrust=-40.2, rotation='ccw'))}"/>
  </xacro:macro>

  <xacro:macro name="t200_prop_ccw"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='1 0 0'">
    <xacro:t200_prop_ccw_info/>

    <link name="${name}">
      <inertial>
        <origin xyz="5.2e-05 0.002765 0.000116" rpy="0 0 0"/>
        <mass value="0.0390534"/>
        <inertia ixx="7.71723e-06" ixy="0" ixz="2.08761e-13"
                 iyy="7.07841e-06" iyz="0"
                 izz="7.07841e-06"/>
      </inertial>
      <xacro:part_visual mesh="package://bluerobotics_parts/models/t200_prop_ccw/t200_prop_ccw.visual.glb"/>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="5.2e-05 0.002765 0.000116" rpy="-0 1.5708 0"/>
          <geometry>
            <cylinder radius="0.01988" length="0.031454"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="${part_info['attach']}"/>
    <xacro:part_slots name="${name}" items="${list(part_info['slots'].items())}"/>
    <xacro:part_frames name="${name}" items="${list(part_info['frames'].items())}"/>

  </xacro:macro>

</robot>
