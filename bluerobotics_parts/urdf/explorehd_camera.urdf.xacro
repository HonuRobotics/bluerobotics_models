<?xml version="1.0"?>
<!--
  explorehd_camera part macro: a DWE exploreHD underwater camera.

  Ported from the BlueROV2 accessory macros; a sized cylinder placeholder until a
  real mesh is delivered. Visual only, like the accessory it replaces (the
  chassis carries the vehicle's contact geometry).

  Contract (see parts.xacro): <part>_info exports the metadata (attach,
  slots, frames, drive); <part> instantiates the link, its mounting joint
  and its slot / frame links.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="explorehd_camera_info">
    <xacro:property name="part_info" scope="parent" value="${dict(
        attach='0 0 0',
        slots=dict(
        ),
        frames=dict(
        ))}"/>
  </xacro:macro>

  <xacro:macro name="explorehd_camera"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='1 0 0'">
    <xacro:explorehd_camera_info/>
    <xacro:property name="_r" value="0.0195"/>
    <xacro:property name="_l" value="0.12"/>
    <xacro:property name="_m" value="0.08"/>

    <link name="${name}">
      <inertial>
        <mass value="${_m}"/>
        <inertia ixx="${_m/12.0 * (3*_r**2 + _l**2)}" ixy="0" ixz="0"
                 iyy="${_m/12.0 * (3*_r**2 + _l**2)}" iyz="0"
                 izz="${_m/2.0 * _r**2}"/>
      </inertial>
      <visual>
        <geometry><cylinder radius="${_r}" length="${_l}"/></geometry>
        <material name="${name}_mat"><color rgba="0.5 0.5 0.55 1"/></material>
      </visual>
    </link>

    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="${part_info['attach']}"/>
    <xacro:part_slots name="${name}" items="${list(part_info['slots'].items())}"/>
    <xacro:part_frames name="${name}" items="${list(part_info['frames'].items())}"/>

  </xacro:macro>

</robot>
