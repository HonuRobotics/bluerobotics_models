<?xml version="1.0"?>
<!--
  blueboat_chassis part macro.

  Bootstrapped from models/blueboat_chassis/model.sdf by scripts/sdf_to_part.py on
  2026-08-20. This file is the part: maintain it by hand from here on.

  Inertia: tensor shape estimated from the collision geometry, scaled from 68.139 kg at 1000 kg/m^3 to the stated 12 kg.

  Contract (see parts.xacro): name parent xyz rpy collision joint axis.
  Sockets other parts mount on, as frames <name>_<socket>:
    motor_port
    motor_stbd
    mast_socket
    flag_socket
    payload
    ping_mount
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="blueboat_chassis"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='1 0 0'">

    <link name="${name}">
      <inertial>
        <origin xyz="0.0212659 0 0.0724998" rpy="0 0 0"/>
        <mass value="12"/>
        <inertia ixx="1.6043" ixy="-1.22202e-18" ixz="0.00372803"
                 iyy="0.988314" iyz="4.88808e-18"
                 izz="2.53089"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://bluerobotics_parts/models/blueboat_chassis/blueboat_chassis.visual.glb"/>
        </geometry>
      </visual>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="-0.002666 -0.368156 0.131239" rpy="0 0 0"/>
          <geometry>
            <box size="0.439118 0.157103 0.079944"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="-0.002666 0.368156 0.131239" rpy="0 -0 0"/>
          <geometry>
            <box size="0.439118 0.157103 0.079944"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.299228 0 0.126654" rpy="0 0 0"/>
          <geometry>
            <box size="0.033317 0.572185 0.041201"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="-0.297919 0 0.126654" rpy="0 0 0"/>
          <geometry>
            <box size="0.033317 0.572185 0.041201"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.026602 -0.36148 0.059302" rpy="-0 1.5708 0"/>
          <geometry>
            <cylinder radius="0.091714" length="1.05084"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.026602 0.36148 0.059302" rpy="-0 1.5708 0"/>
          <geometry>
            <cylinder radius="0.091714" length="1.05084"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <!-- attach: where this part bolts onto its parent, in the part frame;
         the joint places that point at the requested pose. -->
    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="0 0 0"/>

    <!-- Sockets: frames where other parts mount, in the part frame. -->
    <xacro:part_socket name="${name}_motor_port" parent="${name}" xyz="-0.52 0.301 -0.117"/>
    <xacro:part_socket name="${name}_motor_stbd" parent="${name}" xyz="-0.52 -0.301 -0.117"/>
    <xacro:part_socket name="${name}_mast_socket" parent="${name}" xyz="-0.298 0 0.147"/>
    <xacro:part_socket name="${name}_flag_socket" parent="${name}" xyz="-0.298 0.2 0.147"/>
    <xacro:part_socket name="${name}_payload" parent="${name}" xyz="0.299 0 0.147"/>
    <xacro:part_socket name="${name}_ping_mount" parent="${name}" xyz="0 -0.12 0.1"/>

  </xacro:macro>

</robot>
