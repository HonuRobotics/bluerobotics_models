<?xml version="1.0"?>
<!--
  surveyor_multibeam part macro. GENERATED FILE, DO NOT EDIT.

  Written by scripts/import_part.py from models/surveyor_multibeam/model.sdf (the
  modeler delivery) and models/surveyor_multibeam/surveyor_multibeam.yaml (measured values and
  mounts); rerun the import to change anything here.

  Inertia: auto inertia from the delivered collision geometry at 1000 kg/m^3.

  Macro contract: name parent xyz rpy collision, plus joint (fixed by
  default) and axis for parts that spin. parent="" emits the link alone,
  for the part that serves as the assembly root.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="surveyor_multibeam"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='0 0 1'">

    <link name="${name}">
      <inertial>
        <origin xyz="-0.00255219 -0.000106891 -0.00198043" rpy="0 0 0"/>
        <mass value="0.698641"/>
        <inertia ixx="0.000511009" ixy="2.87141e-06" ixz="-1.38952e-06"
                 iyy="0.00161571" iyz="2.95116e-07"
                 izz="0.00170839"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://bluerobotics_parts/models/surveyor_multibeam/surveyor_multibeam.visual.glb"/>
        </geometry>
      </visual>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="-0.003761 -8.9e-05 0.002653" rpy="0 -0 0"/>
          <geometry>
            <box size="0.146896 0.067019 0.056353"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="-0.004562 3.4e-05 -0.021276" rpy="0 -0 0"/>
          <geometry>
            <box size="0.171913 0.090927 0.008497"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.084398 -0.015071 -0.002678" rpy="-0 1.5708 0"/>
          <geometry>
            <cylinder radius="0.008067" length="0.031815"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.07957 0.015057 -0.002678" rpy="-0 1.5708 0"/>
          <geometry>
            <cylinder radius="0.008067" length="0.022158"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:if value="${parent != ''}">
      <joint name="${name}_joint" type="${joint}">
        <parent link="${parent}"/>
        <child link="${name}"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <xacro:if value="${joint != 'fixed'}">
          <axis xyz="${axis}"/>
        </xacro:if>
      </joint>
    </xacro:if>

  </xacro:macro>

</robot>
