<?xml version="1.0"?>
<!--
  blueboat_payload_bracket part macro.

  Bootstrapped from models/blueboat_payload_bracket/model.sdf by scripts/sdf_to_part.py on
  2026-08-20. This file is the part: maintain it by hand from here on.

  Inertia: estimated from the delivered collision geometry at 1000 kg/m^3 (SDF auto inertia); replace with measured values.

  Contract (see parts.xacro): name parent xyz rpy collision joint axis.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="blueboat_payload_bracket"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='1 0 0'">

    <link name="${name}">
      <inertial>
        <origin xyz="0.016201 0 -0.009094" rpy="0 0 0"/>
        <mass value="0.0750918"/>
        <inertia ixx="0.000380547" ixy="0" ixz="0"
                 iyy="3.5504e-05" iyz="0"
                 izz="0.000415846"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://bluerobotics_parts/models/blueboat_payload_bracket/blueboat_payload_bracket.visual.glb"/>
        </geometry>
      </visual>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="0.016201 0 -0.009094" rpy="0 -0 0"/>
          <geometry>
            <box size="0.075215 0.24657 0.004049"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <!-- attach: where this part bolts onto its parent, in the part frame;
         the joint places that point at the requested pose. -->
    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="0 0 0"/>

  </xacro:macro>

</robot>
