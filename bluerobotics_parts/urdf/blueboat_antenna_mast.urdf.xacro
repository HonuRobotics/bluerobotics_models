<?xml version="1.0"?>
<!--
  blueboat_antenna_mast part macro. GENERATED FILE, DO NOT EDIT.

  Written by scripts/import_part.py from models/blueboat_antenna_mast/model.sdf (the
  modeler delivery) and models/blueboat_antenna_mast/blueboat_antenna_mast.yaml (measured values and
  mounts); rerun the import to change anything here.

  Inertia: auto inertia from the delivered collision geometry at 1000 kg/m^3.

  Macro contract: name parent xyz rpy collision, plus joint (fixed by
  default) and axis for parts that spin. parent="" emits the link alone,
  for the part that serves as the assembly root.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="blueboat_antenna_mast"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='0 0 1'">

    <link name="${name}">
      <inertial>
        <origin xyz="-0.004079 -4.3e-05 0.100422" rpy="0 0 0"/>
        <mass value="0.303561"/>
        <inertia ixx="0.0159029" ixy="0" ixz="0"
                 iyy="0.0159029" iyz="0"
                 izz="1.85026e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://bluerobotics_parts/models/blueboat_antenna_mast/blueboat_antenna_mast.visual.glb"/>
        </geometry>
      </visual>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="-0.004079 -4.3e-05 0.100422" rpy="0 -0 0"/>
          <geometry>
            <cylinder radius="0.011041" length="0.792647"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:if value="${parent != ''}">
      <joint name="${name}_joint" type="${joint}">
        <parent link="${parent}"/>
        <child link="${name}"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <xacro:if value="${joint != 'fixed'}">
          <axis xyz="${axis}"/>
        </xacro:if>
      </joint>
    </xacro:if>

  </xacro:macro>

</robot>
