<?xml version="1.0"?>
<!--
  t200_thruster part macro.

  Bootstrapped from models/t200_thruster/model.sdf by scripts/sdf_to_part.py on
  2026-08-21. This file is the part: maintain it by hand from here on.

  Inertia: tensor shape estimated from the collision geometry, scaled from 0.455 kg at 1000 kg/m^3 to the stated 0.344 kg.

  Contract (see parts.xacro): <part>_info exports the metadata (attach,
  slots, frames, drive); <part> instantiates the link, its mounting joint
  and its slot / frame links.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="t200_thruster_info">
    <xacro:property name="part_info" scope="parent" value="${dict(
        attach='0 0 0',
        slots=dict(
        ),
        frames=dict(
        ))}"/>
  </xacro:macro>

  <xacro:macro name="t200_thruster"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='1 0 0'">
    <xacro:t200_thruster_info/>

    <link name="${name}">
      <inertial>
        <origin xyz="-0.00688307 0.00285552 -0.000166273" rpy="0 0 0"/>
        <!-- Body only: the full T200 is 0.344 kg in air; its propeller is
             the separate t200_prop part (0.0391 kg), so body + prop sum to
             the real thruster. -->
        <mass value="0.3049466"/>
        <inertia ixx="2.775723e-04" ixy="-1.156873e-08" ixz="-2.270274e-07"
                 iyy="2.584156e-04" iyz="-3.105837e-10"
                 izz="2.584094e-04"/>
      </inertial>
      <xacro:part_visual mesh="package://bluerobotics_parts/models/t200_thruster/t200_thruster.visual.glb"/>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="-0.010188 0.002851 -0.000255" rpy="-0 1.5708 0"/>
          <geometry>
            <cylinder radius="0.048798" length="0.043629"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.001508 0.002867 5.9e-05" rpy="-0 1.5708 0"/>
          <geometry>
            <cylinder radius="0.019913" length="0.103193"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="${part_info['attach']}"/>
    <xacro:part_slots name="${name}" items="${list(part_info['slots'].items())}"/>
    <xacro:part_frames name="${name}" items="${list(part_info['frames'].items())}"/>

  </xacro:macro>

</robot>
