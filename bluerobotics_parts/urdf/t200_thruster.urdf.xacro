<?xml version="1.0"?>
<!--
  t200_thruster part macro.

  Bootstrapped from models/t200_thruster/model.sdf by scripts/sdf_to_part.py on
  2026-08-20. This file is the part: maintain it by hand from here on.

  Inertia: tensor shape estimated from the collision geometry, scaled from 0.455 kg at 1000 kg/m^3 to the stated 0.344 kg.

  Contract (see parts.xacro): name parent xyz rpy collision joint axis.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="t200_thruster"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='1 0 0'">

    <link name="${name}">
      <inertial>
        <origin xyz="-0.00688307 0.00285552 -0.000166273" rpy="0 0 0"/>
        <mass value="0.344"/>
        <inertia ixx="0.00031312" ixy="-1.30503e-08" ixz="-2.56102e-07"
                 iyy="0.00029151" iyz="-3.50359e-10"
                 izz="0.000291503"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://bluerobotics_parts/models/t200_thruster/t200_thruster.visual.glb"/>
        </geometry>
      </visual>
      <xacro:if value="${collision}">
        <collision>
          <origin xyz="-0.010188 0.002851 -0.000255" rpy="-0 1.5708 0"/>
          <geometry>
            <cylinder radius="0.048798" length="0.043629"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.001508 0.002867 5.9e-05" rpy="-0 1.5708 0"/>
          <geometry>
            <cylinder radius="0.019913" length="0.103193"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <!-- attach: where this part bolts onto its parent, in the part frame;
         the joint places that point at the requested pose. -->
    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="0 0 0"/>

  </xacro:macro>

</robot>
