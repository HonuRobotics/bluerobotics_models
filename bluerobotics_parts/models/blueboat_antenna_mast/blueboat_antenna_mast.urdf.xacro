<?xml version="1.0"?>
<!--
  blueboat_antenna_mast — part macro.

  This file is HAND-AUTHORED and is never written by tooling. This part's mass,
  inertia tensor and center-of-gravity pose are stated here and nowhere else;
  nothing downstream re-derives them, and assemblies compose what is written
  here. See AUR_BUOYANCY_DESIGN.md.

  The generated half lives in its own file, so the two never share a file and
  a re-import cannot touch anything written by hand:

    blueboat_antenna_mast.collision.xacro   GENERATED by scripts/import_part.py
                                            from model.sdf, overwritten on every
                                            re-import. model.sdf is the
                                            modeler's work product; the
                                            generated xacro is what ROS and
                                            Gazebo read.

  This collision is tied to the part. When assembled into a vehicle the
  collision geometry can be ignored — see collision:=false in the macro call.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Included at file scope rather than inside the macro: xacro resolves
       includes in a pass before macros expand. -->
  <xacro:include filename="$(find bluerobotics_parts)/models/blueboat_antenna_mast/blueboat_antenna_mast.collision.xacro"/>

  <!--
    name       link name for this instance; the fixed joint is <name>_joint
    parent     link to attach to
    xyz / rpy  mount pose relative to parent (metres / radians)
    collision  false to instantiate the part with no contact geometry

    Instance-named rather than prefixed, matching accessories.xacro, so the
    same part can be mounted more than once without a name collision.
  -->
  <xacro:macro name="blueboat_antenna_mast"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true">

    <link name="${name}">
      <inertial>
        <!-- TODO: Update. Rough numbers for the prototype — a slender rod.
             These also assume a mesh whose origin is at the base of the mast.
             The delivered mesh currently is, but that violates rule 2 (origin
             at the centroid of the mesh) and is back with the modeler. Revisit
             this origin when the corrected mesh lands. -->
        <origin xyz="0 0 0.5" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.0833" ixy="0.0" ixz="0.0"
                 iyy="0.0833" iyz="0.0"
                 izz="0.0001"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <!-- Delivered by the modeler; PBR materials ride inside the .glb. -->
          <mesh filename="package://bluerobotics_parts/models/blueboat_antenna_mast/blueboat_antenna_mast.visual.glb"/>
        </geometry>
      </visual>

      <xacro:if value="${collision}">
        <xacro:blueboat_antenna_mast_collision/>
      </xacro:if>

    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

  </xacro:macro>

</robot>
