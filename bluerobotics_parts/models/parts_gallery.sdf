<?xml version="1.0"?>
<!--
  Gallery of the BlueBoat parts delivered in PR #5, laid out for visual review.

  Contains every part under models/ that ships both a mesh and a model.sdf -
  14 of 28 directories. Parts are inlined (they carry no model.config,
  so <include> is unavailable) with their mesh URIs rewritten relative to
  this file. Regenerate rather than hand-edit when parts land.

  Run:  gz sim <this file>

  Laid out in groups, +y between groups, +x within a group:
    vessel       blueboat_chassis
    masts        basestation_antenna blueboat_antenna_mast blueboat_flag
    mounts       blueboat_payload_bracket blueboat_ping_singlebeam_mount
    propulsion   m200_weedless_prop_ccw m200_weedless_prop_cw t200_prop_ccw t200_prop_cw t200_thruster
    sensors      omniscan_450_sidescan ping_singlebeam surveyor_multibeam

  Every part's ORIGIN sits at z = 1.0, clear of the ground plane so nothing is
  obscured from below. The origins are coplanar, so origin convention is still
  comparable part to part: a part origined at its base sits entirely above the
  line its neighbours straddle. The ground plane at z = 0 and the 1 m grid are
  spatial reference only.

  Turn on View -> Collisions to check contact geometry against the mesh.

  Not yet delivered (directory exists, no mesh or model.sdf):
    bluerov2_chassis
    bluerov2_heavy_chassis
    bluerov2_payload_skid
    bluerov2_roof_rack
    explorehd_camera
    marinesitu_c3_stereocamera
    newton_gripper_cylinder
    newton_gripper_jaw
    newton_gripper_shaft
    newton_sampler_cup
    omniscan_450fs_imaging
    ping360_scanning
    sonoptix_echo_multibeam
    waterlinked_a50_dvl
-->
<sdf version="1.10">
  <world name="parts_sandbox">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.6 0.6 0.6</ambient>
      <background>0.25 0.27 0.30</background>
      <grid>true</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>2 -2 4 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>-2 3 3 0 0 0</pose>
      <diffuse>0.45 0.45 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.6 -0.4 -0.6</direction>
    </light>

    <model name="reference_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>4.5 4.5</size></plane></geometry>
          <material>
            <ambient>0.30 0.30 0.33 1</ambient>
            <diffuse>0.38 0.38 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- vessel -->
    <model name="blueboat_chassis">
      <link name="blueboat_chassis_link">
        <visual name="blueboat_chassis_visual">
          <geometry>
            <mesh>
              <uri>blueboat_chassis/blueboat_chassis.visual.glb</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="blueboat_chassis_collider_box">
          <pose>-0.002666 -0.368156 0.131239 0.0 0.0 0.0</pose>
          <geometry>
            <box>
              <size>0.439118 0.157103 0.079944</size>
            </box>
          </geometry>
        </collision>
        <collision name="blueboat_chassis_collider_box_1">
          <pose>-0.002666 0.368156 0.131239 0.0 -0.0 0.0</pose>
          <geometry>
            <box>
              <size>0.439118 0.157103 0.079944</size>
            </box>
          </geometry>
        </collision>
        <collision name="blueboat_chassis_collider_box_2">
          <pose>0.299228 0.0 0.126654 0.0 0.0 0.0</pose>
          <geometry>
            <box>
              <size>0.033317 0.572185 0.041201</size>
            </box>
          </geometry>
        </collision>
        <collision name="blueboat_chassis_collider_box_3">
          <pose>-0.297919 0.0 0.126654 0.0 0.0 0.0</pose>
          <geometry>
            <box>
              <size>0.033317 0.572185 0.041201</size>
            </box>
          </geometry>
        </collision>
        <collision name="blueboat_chassis_collider_cylinder">
          <pose>0.026602 -0.36148 0.059302 0.0 0.0 0.0</pose>
          <geometry>
            <cylinder>
              <radius>0.525418</radius>
              <length>0.183428</length>
            </cylinder>
          </geometry>
        </collision>
        <collision name="blueboat_chassis_collider_cylinder_1">
          <pose>0.026602 0.36148 0.059302 0.0 -0.0 0.0</pose>
          <geometry>
            <cylinder>
              <radius>0.525418</radius>
              <length>0.183428</length>
            </cylinder>
