      <visual name="blueboat_flag_visual">
        <geometry>
          <mesh>
            <uri>blueboat_flag.visual.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="blueboat_flag_collider_cylinder">
        <pose>0.0 -0.000467 -0.013148 0.0 -0.0 0.0</pose>
        <geometry>
          <cylinder>
            <radius>0.002635</radius>
            <length>0.9948</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>