      <visual name="newton_gripper_cylinder_visual">
        <geometry>
          <mesh>
            <uri>newton_gripper_cylinder.visual.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="cylinder2_collider_cylinder">
