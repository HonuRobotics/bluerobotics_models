<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluerobotics_parts</name>
  <version>0.1.0</version>
  <description>
    Shared part library for Blue Robotics vehicle models. Each part is a single
    physical component - one mesh, no joints, geometry only - delivered by the
    modeller as a .glb and a model.sdf, and exposed to vehicle descriptions as a
    xacro macro. Parts are vehicle-agnostic; assemblies live in the per-vehicle
    description packages.
  </description>
  <maintainer email="acordero@honurobotics.com">Alejandro Hernández Cordero</maintainer>
  <maintainer email="bbingham@honurobotics.com">Brian Bingham</maintainer>
  <maintainer email="caguero@honurobotics.com">Carlos Agüero</maintainer>
  <maintainer email="jrivero@honurobotics.com">Jose Luis Rivero</maintainer>
  <license file="LICENSE">Apache-2.0</license>
  <url type="website">https://honurobotics.github.io/bluerobotics_models/</url>
  <url type="repository">https://github.com/HonuRobotics/bluerobotics_models</url>
  <url type="bugtracker">https://github.com/HonuRobotics/bluerobotics_models/issues</url>
  <author email="caguero@honurobotics.com">Carlos Agüero</author>
  <author email="bbingham@honurobotics.com">Brian Bingham</author>
  <author>Honu Robotics</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>liburdfdom-tools</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
