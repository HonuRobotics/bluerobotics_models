<?xml version="1.0"?>
<!--
  Self-contained Gazebo Sim world for the BlueBoat: sun, a seabed plane at
  z -3, graded buoyancy (seawater below z 0, air above), a visual water
  surface at the waterline, the core systems and the vehicle pulled in via
  <include>. Started directly it comes up paused; press play and the boat
  settles to its static draft and floats level (base_link at the waterline). Hydrodynamic
  damping lives in the included model; tuning the coefficients against the
  real vehicle is the deferred part.

  Run it directly, no ROS:  gz sim <this file>
-->
<sdf version="1.12">
  <world name="blueboat_playground">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Renders the echosounder (gpu_lidar) sensor; needs a GPU + ogre2. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Graded buoyancy: seawater (1025) below z=0, air above -> the BlueBoat
         floats at the z=0 waterline. Displacement comes from the pontoon-box
         collisions (graded mode rejects the mesh hull); the boat self-settles to
         its draft. -->
    <plugin filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1025</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable>blueboat</enable>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Seabed 3 m down (down-looking sensors get a return; also a safety floor
         if buoyancy is mistuned). The boat floats clear of it. -->
    <model name="seabed">
      <static>true</static>
      <pose>0 0 -3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <material>
            <ambient>0.30 0.28 0.20 1</ambient>
            <diffuse>0.35 0.32 0.24 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual-only water surface at the z=0 graded-buoyancy waterline. -->
    <model name="water_surface">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <transparency>0.4</transparency>
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <material>
            <ambient>0.10 0.30 0.50 1</ambient>
            <diffuse>0.10 0.35 0.55 1</diffuse>
            <specular>0.20 0.30 0.40 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- The vehicle, pulled in from blueboat_gazebo (the composed model). -->
    <include>
      <uri>model://blueboat_gazebo</uri>
      <name>blueboat</name>
      <pose>0 0 0.05 0 0 0</pose>
    </include>

  </world>
</sdf>
