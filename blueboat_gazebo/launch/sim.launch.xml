<?xml version="1.0"?>
<!--
  Bring up Gazebo with the BlueBoat.

  Everything about the vehicle is derived from config_file at launch time by
  configure_vehicle.py (URDF, composed model, ros_gz bridge config, into a
  temporary directory), so a custom loadout needs no rebuild and works the
  same from a source build or a binary install. The world is vehicle free
  (blueboat_water.sdf by default) and the generated model is spawned into it
  as "blueboat". With use_composition (default), gz_server, the bridge and
  robot_state_publisher run as composable nodes in ONE container process;
  the Gazebo GUI runs as a separate process. The simulation starts running
  and the boat floats at its static draft.

      ros2 launch blueboat_gazebo sim.launch.xml
      ros2 launch blueboat_gazebo sim.launch.xml config_file:=/path/my_loadout.yaml
-->
<launch>
  <arg name="world"
       default="$(find-pkg-share blueboat_gazebo)/worlds/blueboat_water.sdf"
       description="Vehicle free world SDF to spawn the boat into."/>
  <arg name="use_composition" default="true"
       description="Run gz_server, bridge and robot_state_publisher in one process."/>
  <arg name="gui" default="true" description="Launch the Gazebo GUI."/>
  <arg name="config_file"
       default="$(find-pkg-share blueboat_description)/config/blueboat.yaml"
       description="Vehicle loadout config, expanded at launch."/>
  <arg name="name" default="blueboat"
       description="Model name to spawn as; the world's buoyancy and the bridge expect blueboat."/>
  <arg name="z" default="0.05" description="Spawn height (m); the default sits at the waterline."/>

  <!-- Every artifact of this loadout, generated now from config_file. -->
  <let name="vehicle_dir"
       value="$(command '$(find-pkg-prefix blueboat_gazebo)/lib/blueboat_gazebo/configure_vehicle.py --config $(var config_file) --temp')"/>
  <let name="robot_description" value="$(command 'cat $(var vehicle_dir)/blueboat.urdf')"/>

  <!-- Gazebo server (composable) — creates the shared container. -->
  <gz_server world_sdf_file="$(var world)"
             container_name="ros_gz_container"
             create_own_container="true"
             use_composition="$(var use_composition)"/>

  <!-- Gazebo GUI (separate Qt process). -->
  <executable cmd="gz sim -g" output="screen" if="$(var gui)"/>

  <!-- The vehicle, spawned from the generated model into the (only) world. -->
  <node pkg="ros_gz_sim" exec="create" name="spawn_blueboat" output="screen"
        args="-name $(var name) -z $(var z) -file $(var vehicle_dir)/model.sdf"/>

  <!-- ros_gz bridge (composable) — joins the container; bridges the clock. -->
  <ros_gz_bridge bridge_name="ros_gz_bridge"
                 config_file="$(var vehicle_dir)/ros_gz_bridge.yaml"
                 container_name="ros_gz_container"
                 create_own_container="false"
                 use_composition="$(var use_composition)"/>

  <!-- robot_state_publisher: composable node in the container when composing... -->
  <load_composable_node target="ros_gz_container" if="$(var use_composition)">
    <composable_node pkg="robot_state_publisher"
                     plugin="robot_state_publisher::RobotStatePublisher"
                     name="robot_state_publisher">
      <param name="robot_description" value="$(var robot_description)" type="str"/>
      <param name="use_sim_time" value="true" type="bool"/>
    </composable_node>
  </load_composable_node>

  <!-- ...or a plain node when composition is disabled. -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher"
        name="robot_state_publisher" unless="$(var use_composition)">
    <param name="robot_description" value="$(var robot_description)"/>
    <param name="use_sim_time" value="true"/>
  </node>
</launch>
