<?xml version="1.0"?>
<model>
  <name>BlueBoat</name>
  <version>1.0</version>
  <sdf version="1.12">model.sdf</sdf>

  <author>
    <name>Carlos Agüero</name>
    <email>caguero@honurobotics.com</email>
  </author>

  <description>
    Simulation-ready BlueBoat: merges the blueboat_description base model and is
    where the Gazebo plugins live. A world can pull it in via
    model://blueboat_gazebo, or it can be spawned at runtime with ros_gz_sim
    create.
  </description>
</model>
