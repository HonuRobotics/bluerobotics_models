# BlueBoat parameters for ArduRover SITL.
#
# Derived from Blue Robotics' own dump off the vehicle:
#
#   bluerobotics/Blueos-Parameter-Repository
#   params/ardupilot/ArduRover/4.7/Navigator/BlueBoat120.params
#   (header: Vehicle: Surface Boat / Platform: navigator / Version: 4.7.0-BETA)
#
# That file is 951 lines because it is a complete dump, most of which is one
# unit's calibration, radio setup and logging. This file carries the subset
# that describes the *vehicle* - frame, outputs, motor limits, control gains,
# speeds - plus the deltas simulation requires. Every value below is the
# shipped one unless a DELTA comment says otherwise.
#
# Load it LAST. `-f rover-skid` makes sim_vehicle.py load ArduPilot's own rover.parm and rover-skid.parm first: the SITL side (accelerometer calibration so pre-arm passes, SIM_PIN_MASK, mode slots), but also SERVO1/3_MIN/MAX at 1000/2000 and SERVO1_FUNCTION 73 / SERVO3_FUNCTION 74, the reverse of the shipped boat. Every one of those is set again below, and the last file wins:
#
#   sim_vehicle.py -v Rover -f rover-skid --model JSON --console --map -w \
#     --add-param-file=$AP/default_params/rover.parm \
#     --add-param-file=<this file>
#
# The explicit rover.parm repeats what `-f` already loaded. It is harmless and is kept so the command reads the same on newer ArduPilot, which stops loading frame defaults when `--model` is given.

# ---- Frame ----------------------------------------------------------------
FRAME_CLASS      2          # Boat
FRAME_TYPE       0

# ---- Motor outputs --------------------------------------------------------
# Note the assignment: SERVO1 carries the RIGHT throttle and SERVO3 the LEFT.
# That is the shipped boat, and it is the opposite of both ArduPilot's
# rover-skid defaults and the BlueBoat in ArduPilot/SITL_Models.
SERVO1_FUNCTION  74         # ThrottleRight -> starboard
SERVO1_MIN       1100
SERVO1_MAX       1900
SERVO1_TRIM      1500       # DELTA: shipped 1510. One unit's calibration, not
                            # a design value; carried into simulation it puts
                            # a standing +0.025 on the output and the boat
                            # creeps at idle.
SERVO1_REVERSED  0

SERVO3_FUNCTION  73         # ThrottleLeft -> port
SERVO3_MIN       1100
SERVO3_MAX       1900
SERVO3_TRIM      1500       # DELTA: as SERVO1_TRIM above.
SERVO3_REVERSED  0          # DELTA: shipped 1. On the vehicle this
                            # compensates for how that thruster is wired.
                            # There is no such wiring in simulation, and
                            # applying it drives the port thruster backwards,
                            # so the boat turns on the spot instead of moving.

SERVO_RATE       50

# ---- Motor limits and mixing ----------------------------------------------
MOT_THR_MIN      0
MOT_THR_MAX      100
MOT_SLEWRATE     200
MOT_STR_THR_MIX  0.6
MOT_THST_ASYM    1.6        # Forward/reverse thrust ratio; ArduPilot scales reverse outputs up by it. The simulated thruster models the same asymmetry its own way, scaling each direction on its own limit (51.5 N ahead and 40.2 N astern at present, a 1.28 ratio, and placeholders), so the two are applied in series. Reconciling them is part of the stabilization-layer work.

# ---- Speeds and navigation ------------------------------------------------
CRUISE_SPEED     1
CRUISE_THROTTLE  16
SPEED_MAX        3          # Shipped. Omitting it is not the same as leaving
                            # it off: at 0 ArduRover estimates it as
                            # CRUISE_SPEED / CRUISE_THROTTLE, which with the
                            # two lines above is 6.25 m/s - twice what the
                            # boat can do, so full throttle in ACRO demands a
                            # speed it can never reach and the loop winds up.
ACRO_TURN_RATE   45         # Shipped, deg/s. The firmware default is 180, so
                            # omitting it asks for four times the turn rate
                            # the vehicle is rated for.
WP_SPEED         1
WP_RADIUS        1
TURN_RADIUS      0.1
PILOT_STEER_TYPE 3

# ---- Control gains --------------------------------------------------------
# Shipped verbatim. Whether these work unmodified against our thrust model is a question for the stabilization-layer work, so they are deliberately not retuned here.
ATC_SPEED_P      1
ATC_SPEED_I      0.2
ATC_SPEED_D      0
ATC_STR_ANG_P    1.2
ATC_STR_RAT_P    1
ATC_STR_RAT_I    0
ATC_STR_RAT_D    0
ATC_STR_RAT_FF   0.8
ATC_STR_RAT_FLTE 10
ATC_STR_RAT_FLTT 0
ATC_ACCEL_MAX    0.7
ATC_DECEL_MAX    1
ATC_BRAKE        1
ATC_STOP_SPEED   0.1
ATC_TURN_MAX_G   0.1

# ---- Arming ---------------------------------------------------------------
ARMING_REQUIRE   1
