<?xml version="1.0"?>
<!--
  BlueROV2 remotely operated vehicle, assembled from bluerobotics_parts.

  Everything about the vehicle comes from the config (which parts, where)
  and from the part macros (geometry, inertia). The base picks the variant:
  bluerov2_chassis (standard, 6 thrusters) or bluerov2_heavy_chassis
  (Heavy kit, 8). Buoyancy is a simulator concern: bluerov2_gazebo realizes
  the config's buoyancy declaration as a dedicated displacement link (docs:
  design/buoyancy). No Gazebo tags or plugins here.

      xacro bluerov2.urdf.xacro > bluerov2.urdf                    # default configuration
      xacro bluerov2.urdf.xacro config_file:=/path/my_vehicle.yaml # custom
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="bluerov2">

  <xacro:include filename="$(find bluerobotics_parts)/urdf/assembly.xacro"/>

  <!-- Config file: REMAP'd to the source config at build time; the default
       is the installed copy for manual/runtime use. -->
  <xacro:arg name="config_file"
             default="$(find bluerov2_description)/config/bluerov2.yaml"/>
  <xacro:property name="cfg" value="${xacro.load_yaml('$(arg config_file)')}"/>

  <!-- Chassis as the root; its slots fill with their defaults, the config
       overrides and adds. -->
  <xacro:assemble base="${cfg['base']}" parts="${cfg.get('parts') or []}"
                  slots="${cfg.get('slots') or []}"/>

</robot>
