<?xml version="1.0"?>
<!--
  BlueROV2 accessory macros + a recursive dispatcher that mounts the accessories
  listed in config/bluerov2.yaml. Each accessory is a link (mesh or a sized
  primitive placeholder) attached to the parent by a fixed joint at the config
  pose. Meshes/sizes are temporary placeholders (see ACCESSORIES.md); sensor
  and claw behaviour lives in bluerov2_gazebo. Type names here MUST match
  the config's `type`.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Single source of truth for accessory masses (kg). Consumed by the macros
       below AND by the buoyancy sizing in bluerov2.urdf.xacro. Keep the keys in
       sync with the macro / dispatcher type names. Placeholder values. -->
  <xacro:property name="accessory_mass"
    value="${dict(ping360=0.5, payload_skid=3.0, roof_rack=0.2, sonoptix_echo=0.75, omniscan_450_fs=0.44, marinesitu_c3=0.43, explorehd_camera=0.08, dvl_a50=0.17, newton_gripper=0.5, sediment_sampler=0.5)}"/>

  <!-- Displaced volume (m^3) of each accessory's COLLISION geometry. The
       Buoyancy plugin sums every collision in the model, so the analytic hull
       box in bluerov2.urdf.xacro must shrink by this amount to keep the total
       displacement on target. Only the claws carry collisions; keep these in
       sync with the collision boxes below. -->
  <xacro:property name="accessory_volume"
    value="${dict(ping360=0.0, payload_skid=0.0, roof_rack=0.0, sonoptix_echo=0.0, omniscan_450_fs=0.0, marinesitu_c3=0.0, explorehd_camera=0.0, dvl_a50=0.0, newton_gripper=0.05*0.06*0.06 + 2*0.06*0.012*0.03, sediment_sampler=0.05*0.06*0.06 + 2*0.09*0.02*0.026)}"/>

  <!-- ===== helpers ===== -->
  <!-- Inertia tensors follow from the primitive geometry and the mass, so they
       track the mass table and the placeholder dimensions automatically. -->
  <xacro:macro name="_box_accessory" params="name xyz rpy parent size mass:=0.3">
    <xacro:property name="d" value="${[float(v) for v in size.split()]}"/>
    <link name="${name}">
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${float(mass)/12.0 * (d[1]**2 + d[2]**2)}" ixy="0" ixz="0"
                 iyy="${float(mass)/12.0 * (d[0]**2 + d[2]**2)}" iyz="0"
                 izz="${float(mass)/12.0 * (d[0]**2 + d[1]**2)}"/>
      </inertial>
      <visual>
        <geometry><box size="${size}"/></geometry>
        <material name="${name}_mat"><color rgba="0.5 0.5 0.55 1"/></material>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="_cyl_accessory" params="name xyz rpy parent radius length mass:=0.3">
    <link name="${name}">
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${float(mass)/12.0 * (3*float(radius)**2 + float(length)**2)}" ixy="0" ixz="0"
                 iyy="${float(mass)/12.0 * (3*float(radius)**2 + float(length)**2)}" iyz="0"
                 izz="${float(mass)/2.0 * float(radius)**2}"/>
      </inertial>
      <visual>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="${name}_mat"><color rgba="0.5 0.5 0.55 1"/></material>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- ===== accessories ===== -->
  <!-- Ping360 scanning imaging sonar (reused open mesh, Apache-2.0). -->
  <xacro:macro name="ping360" params="name xyz rpy parent:=base_link">
    <link name="${name}">
      <inertial>
        <mass value="${accessory_mass['ping360']}"/>
        <!-- Solid cylinder over the device envelope (r 38 mm, h 117 mm). -->
        <inertia ixx="${accessory_mass['ping360']/12.0 * (3*0.038**2 + 0.117**2)}" ixy="0" ixz="0"
                 iyy="${accessory_mass['ping360']/12.0 * (3*0.038**2 + 0.117**2)}" iyz="0"
                 izz="${accessory_mass['ping360']/2.0 * 0.038**2}"/>
      </inertial>
      <visual>
        <geometry>
          <!-- Mesh is ~100x oversized as authored (7.7x7.7x8.3 units, no
               COLLADA unit element); 0.01 matches CentraleNantes usage. -->
          <mesh filename="package://bluerov2_description/meshes/accessories/ping360.dae"
                scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- Primitive placeholders (dims from product pages; swap for real meshes). -->
  <xacro:macro name="payload_skid" params="name xyz rpy parent:=base_link">
    <xacro:_box_accessory name="${name}" xyz="${xyz}" rpy="${rpy}" parent="${parent}"
                          size="0.475 0.338 0.197" mass="${accessory_mass['payload_skid']}"/>
  </xacro:macro>
  <xacro:macro name="roof_rack" params="name xyz rpy parent:=base_link">
    <xacro:_box_accessory name="${name}" xyz="${xyz}" rpy="${rpy}" parent="${parent}"
                          size="0.38 0.10 0.02" mass="${accessory_mass['roof_rack']}"/>
  </xacro:macro>
  <xacro:macro name="sonoptix_echo" params="name xyz rpy parent:=base_link">
    <xacro:_box_accessory name="${name}" xyz="${xyz}" rpy="${rpy}" parent="${parent}"
                          size="0.150 0.100 0.042" mass="${accessory_mass['sonoptix_echo']}"/>
  </xacro:macro>
  <xacro:macro name="omniscan_450_fs" params="name xyz rpy parent:=base_link">
    <xacro:_box_accessory name="${name}" xyz="${xyz}" rpy="${rpy}" parent="${parent}"
                          size="0.165 0.055 0.033" mass="${accessory_mass['omniscan_450_fs']}"/>
  </xacro:macro>
  <xacro:macro name="marinesitu_c3" params="name xyz rpy parent:=base_link">
    <xacro:_box_accessory name="${name}" xyz="${xyz}" rpy="${rpy}" parent="${parent}"
                          size="0.095 0.165 0.089" mass="${accessory_mass['marinesitu_c3']}"/>
  </xacro:macro>
  <xacro:macro name="explorehd_camera" params="name xyz rpy parent:=base_link">
    <xacro:_cyl_accessory name="${name}" xyz="${xyz}" rpy="${rpy}" parent="${parent}"
                          radius="0.0195" length="0.12" mass="${accessory_mass['explorehd_camera']}"/>
  </xacro:macro>
  <xacro:macro name="dvl_a50" params="name xyz rpy parent:=base_link">
    <xacro:_cyl_accessory name="${name}" xyz="${xyz}" rpy="${rpy}" parent="${parent}"
                          radius="0.033" length="0.025" mass="${accessory_mass['dvl_a50']}"/>
  </xacro:macro>

  <!-- Newton Subsea Gripper (1-DOF): a body fixed to the parent, plus two jaws on
       revolute joints that open/close symmetrically (mirrored axes). Primitive
       placeholder (real mesh TBD); the JointPositionControllers that drive the jaws
       live in bluerov2_gazebo. Jaw command 0 (closed) .. 0.6 rad (open). -->
  <xacro:macro name="_gripper_jaw" params="name side y axis">
    <link name="${name}_jaw_${side}">
      <inertial>
        <origin xyz="0.03 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <!-- Box 0.06 x 0.012 x 0.03, about its own centre (the visual pose). -->
        <inertia ixx="${0.1/12.0 * (0.012**2 + 0.03**2)}" ixy="0" ixz="0"
                 iyy="${0.1/12.0 * (0.06**2 + 0.03**2)}" iyz="0"
                 izz="${0.1/12.0 * (0.06**2 + 0.012**2)}"/>
      </inertial>
      <visual>
        <origin xyz="0.03 0 0" rpy="0 0 0"/>
        <geometry><box size="0.06 0.012 0.03"/></geometry>
        <material name="${name}_jaw_mat"><color rgba="0.5 0.5 0.55 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.03 0 0" rpy="0 0 0"/>
        <geometry><box size="0.06 0.012 0.03"/></geometry>
      </collision>
    </link>
    <joint name="${name}_jaw_${side}_joint" type="revolute">
      <parent link="${name}_body"/><child link="${name}_jaw_${side}"/>
      <origin xyz="0.025 ${y} 0" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="0" upper="0.6" effort="10" velocity="2"/>
    </joint>
  </xacro:macro>

  <!-- Shared claw body: box housing fixed to the parent at the mount pose. -->
  <xacro:macro name="_claw_body" params="name xyz rpy parent">
    <link name="${name}_body">
      <inertial>
        <mass value="0.3"/>
        <!-- Box 0.05 x 0.06 x 0.06 (the housing collision/visual). -->
        <inertia ixx="${0.3/12.0 * (0.06**2 + 0.06**2)}" ixy="0" ixz="0"
                 iyy="${0.3/12.0 * (0.05**2 + 0.06**2)}" iyz="0"
                 izz="${0.3/12.0 * (0.05**2 + 0.06**2)}"/>
      </inertial>
      <visual>
        <geometry><box size="0.05 0.06 0.06"/></geometry>
        <material name="${name}_mat"><color rgba="0.5 0.5 0.55 1"/></material>
      </visual>
      <collision><geometry><box size="0.05 0.06 0.06"/></geometry></collision>
    </link>
    <joint name="${name}_mount" type="fixed">
      <parent link="${parent}"/><child link="${name}_body"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="newton_gripper" params="name xyz rpy parent:=base_link">
    <xacro:_claw_body name="${name}" xyz="${xyz}" rpy="${rpy}" parent="${parent}"/>
    <xacro:_gripper_jaw name="${name}" side="left"  y="0.02"  axis="0 0 1"/>
    <xacro:_gripper_jaw name="${name}" side="right" y="-0.02" axis="0 0 -1"/>
  </xacro:macro>

  <!-- Newton Sediment Sampler: the same 1-DOF claw with rubber-cup end-links
       instead of jaws (the cups ride the open/close DOF - they do not spin). -->
  <xacro:macro name="_sampler_cup" params="name side y axis">
    <link name="${name}_cup_${side}">
      <inertial>
        <origin xyz="0.028 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <!-- Dominant arm box 0.055 x 0.01 x 0.012, about its own centre. -->
        <inertia ixx="${0.1/12.0 * (0.01**2 + 0.012**2)}" ixy="0" ixz="0"
                 iyy="${0.1/12.0 * (0.055**2 + 0.012**2)}" iyz="0"
                 izz="${0.1/12.0 * (0.055**2 + 0.01**2)}"/>
      </inertial>
      <visual>
        <origin xyz="0.028 0 0" rpy="0 0 0"/>
        <geometry><box size="0.055 0.01 0.012"/></geometry>
        <material name="${name}_arm_mat"><color rgba="0.5 0.5 0.55 1"/></material>
      </visual>
      <visual>
        <origin xyz="0.062 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.018" length="0.026"/></geometry>
        <material name="${name}_cup_mat"><color rgba="0.1 0.3 0.8 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.045 0 0" rpy="0 0 0"/>
        <geometry><box size="0.09 0.02 0.026"/></geometry>
      </collision>
    </link>
    <joint name="${name}_cup_${side}_joint" type="revolute">
      <parent link="${name}_body"/><child link="${name}_cup_${side}"/>
      <origin xyz="0.025 ${y} 0" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="0" upper="0.6" effort="10" velocity="2"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="sediment_sampler" params="name xyz rpy parent:=base_link">
    <xacro:_claw_body name="${name}" xyz="${xyz}" rpy="${rpy}" parent="${parent}"/>
    <xacro:_sampler_cup name="${name}" side="left"  y="0.02"  axis="0 0 1"/>
    <xacro:_sampler_cup name="${name}" side="right" y="-0.02" axis="0 0 -1"/>
  </xacro:macro>

  <!-- ===== recursive dispatcher: mount each config accessory by type =====
       The config `type` IS the macro name, invoked directly; an unknown type
       fails the build loudly instead of silently mounting nothing. -->
  <xacro:macro name="mount_accessories" params="items parent:=base_link">
    <xacro:if value="${len(items) > 0}">
      <xacro:property name="a" value="${items[0]}"/>
      <xacro:call macro="${a['type']}" name="${a['name']}"
                  xyz="${a['xyz']}" rpy="${a['rpy']}" parent="${parent}"/>
      <xacro:mount_accessories items="${items[1:]}" parent="${parent}"/>
    </xacro:if>
  </xacro:macro>

</robot>
