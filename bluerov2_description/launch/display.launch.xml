<?xml version="1.0"?>
<!--
  Visualize the BlueROV2 description in RViz: robot_state_publisher,
  joint_state_publisher_gui (sliders to spin the thrusters) and RViz with the
  packaged config. Pure ROS/description - no Gazebo. The URDF is expanded by
  xacro at launch time from `config_file`, so a custom set of accessories needs
  no rebuild (handy for binary/deb installs); the default config reproduces the
  build-time URDF exactly.
-->
<launch>
  <arg name="gui" default="true"
       description="Start joint_state_publisher_gui to drive the joints."/>
  <!-- RViz converts glTF meshes to Z up since Lyrical; older RViz draws
       the Y up data as is. Pass z to pre rotate the visuals for older RViz. -->
  <arg name="gltf_up" default="y"
       description="Keep y for RViz from Lyrical on; pass z for older RViz."/>
  <arg name="config_file"
       default="$(find-pkg-share bluerov2_description)/config/bluerov2.yaml"
       description="Vehicle config (variant + accessories) expanded at launch."/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher"
        name="robot_state_publisher">
    <!-- type="str": keep launch from running yaml type-inference over the URDF. -->
    <param name="robot_description"
           value="$(command 'xacro $(find-pkg-share bluerov2_description)/urdf/bluerov2.urdf.xacro config_file:=$(var config_file) gltf_up:=$(var gltf_up)')"
           type="str"/>
  </node>

  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui"
        name="joint_state_publisher_gui" if="$(var gui)"/>

  <node pkg="rviz2" exec="rviz2" name="rviz2"
        args="-d $(find-pkg-share bluerov2_description)/rviz/bluerov2.rviz"/>
</launch>
