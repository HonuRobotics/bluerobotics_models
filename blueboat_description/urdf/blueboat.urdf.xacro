<?xml version="1.0"?>
<!--
  BlueBoat unmanned surface vessel (twin outboard configuration).

  The two propellers are articulated links; accessories are mounted from
  config/blueboat.yaml. No Gazebo tags or plugins here (those belong in
  blueboat_gazebo). Inertia and link poses reproduce the reference BlueBoat
  layout.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="blueboat">

  <xacro:include filename="thruster.xacro"/>
  <xacro:include filename="accessories.xacro"/>
  <xacro:include filename="batteries.xacro"/>

  <!-- Config file: REMAP'd to the source config at build time; the default is
       the installed copy for manual/runtime use. -->
  <xacro:arg name="config_file"
             default="$(find blueboat_description)/config/blueboat.yaml"/>
  <xacro:property name="cfg" value="${xacro.load_yaml('$(arg config_file)')}"/>

  <!-- Battery catalog + slots + default loadout; REMAP'd at build time like
       config_file. The loadout is cfg's `batteries:` (default when omitted). -->
  <xacro:arg name="batteries_file"
             default="$(find blueboat_description)/config/batteries.yaml"/>
  <xacro:property name="battery_db"
                  value="${xacro.load_yaml('$(arg batteries_file)')}"/>
  <xacro:property name="battery_items"
                  value="${cfg.get('batteries') or battery_db['default_loadout']}"/>

  <!-- Buoyancy hull. Graded buoyancy (surface vessel) rejects mesh collisions, so
       each catamaran pontoon is a primitive box that both displaces water and does
       contact. With graded buoyancy the boat self-settles to a draft roughly
       total_mass / (water_density * 2 * pontoon_length * pontoon_width); tune these
       for the waterline you want (verify the float on a GPU). Dims/offsets approx.
       the two pontoons from the hull collision mesh (~1.19 m long, centres y~0.3). -->
  <xacro:property name="thruster_mass" value="0.344"/>
  <xacro:property name="hull_mass"     value="27.2"/>   <!-- 30.0 minus the two default 18Ah packs -->
  <xacro:property name="pontoon_length" value="1.1"/>
  <xacro:property name="pontoon_width"  value="0.19"/>
  <xacro:property name="pontoon_height" value="0.19"/>
  <xacro:property name="pontoon_x"      value="-0.05"/>   <!-- long. centre = hull CoM x, so buoyancy sits UNDER the CoM (no pitch trim) -->
  <xacro:property name="pontoon_y"      value="0.30"/>    <!-- lateral offset of each pontoon -->
  <xacro:property name="pontoon_z"      value="-0.22"/>   <!-- vertical centre in base_link -->
  <xacro:property name="pontoon_segments" value="6"/>     <!-- box segments per pontoon (distributed buoyancy) -->

  <!-- Distribute each pontoon's buoyancy into N box segments along its length so
       graded buoyancy models the tilted waterplane correctly: each short box
       responds to its OWN local depth, so pitching submerges the down-end segments
       more and restores strongly. A single long box keys off the box-centre depth
       and barely restores pitch (marginal, wave-sensitive). Also the natural base
       for wave response later. Recursive: xacro has no for-loop; i counts 0..n-1. -->
  <xacro:macro name="pontoon" params="side y n i:=0">
    <xacro:if value="${i != n}">
      <xacro:property name="seg_len" value="${pontoon_length / n}"/>
      <xacro:property name="seg_x"   value="${pontoon_x - pontoon_length/2.0 + seg_len*(i + 0.5)}"/>
      <collision name="pontoon_${side}_${i}">
        <origin xyz="${seg_x} ${y} ${pontoon_z}" rpy="0 0 0"/>
        <geometry>
          <box size="${seg_len} ${pontoon_width} ${pontoon_height}"/>
        </geometry>
      </collision>
      <xacro:pontoon side="${side}" y="${y}" n="${n}" i="${i + 1}"/>
    </xacro:if>
  </xacro:macro>

  <!-- Primitive hull visuals: one box per pontoon (matching the buoyancy
       collision), a deck plate and the two outboard motor housings. -->
  <xacro:macro name="hull_visuals">
    <visual>
      <origin xyz="${pontoon_x} ${pontoon_y} ${pontoon_z}" rpy="0 0 0"/>
      <geometry><box size="${pontoon_length} ${pontoon_width} ${pontoon_height}"/></geometry>
      <material name="pontoon_mat"><color rgba="0.12 0.30 0.55 1"/></material>
    </visual>
    <visual>
      <origin xyz="${pontoon_x} ${-pontoon_y} ${pontoon_z}" rpy="0 0 0"/>
      <geometry><box size="${pontoon_length} ${pontoon_width} ${pontoon_height}"/></geometry>
      <material name="pontoon_mat"><color rgba="0.12 0.30 0.55 1"/></material>
    </visual>
    <visual>
      <origin xyz="${pontoon_x} 0 -0.10" rpy="0 0 0"/>
      <geometry><box size="0.55 0.75 0.04"/></geometry>
      <material name="deck_mat"><color rgba="0.75 0.75 0.78 1"/></material>
    </visual>
    <visual>
      <origin xyz="-0.488 0.295 -0.16" rpy="0 0 0"/>
      <geometry><box size="0.07 0.06 0.18"/></geometry>
      <material name="motor_mat"><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
    <visual>
      <origin xyz="-0.488 -0.295 -0.16" rpy="0 0 0"/>
      <geometry><box size="0.07 0.06 0.18"/></geometry>
      <material name="motor_mat"><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
  </xacro:macro>

  <!-- ===================== Base link (hull) ===================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.05 0 -0.20" rpy="0 0 0"/>
      <!-- Hull mass EXCLUDES batteries since the loadout mounts them as
           explicit links (batteries.xacro): the previous 30.0 kg implicitly
           carried the default two 18Ah packs (2.8 kg), subtracted here so the
           all-up default vehicle is unchanged. Tensor scaled with the mass
           (same geometry). -->
      <mass value="${hull_mass}"/>
      <inertia ixx="${2.42369 * hull_mass / 30.0}" ixy="0.0" ixz="0.0"
               iyy="${3.9235025 * hull_mass / 30.0}" iyz="0.0"
               izz="${5.6403125 * hull_mass / 30.0}"/>
    </inertial>

    <!-- Pontoon buoyancy/contact, distributed into pontoon_segments boxes each. -->
    <xacro:pontoon side="port" y="${pontoon_y}"  n="${pontoon_segments}"/>
    <xacro:pontoon side="stbd" y="${-pontoon_y}" n="${pontoon_segments}"/>

    <xacro:hull_visuals/>
  </link>

  <!-- ===================== Thrusters (props) ===================== -->
  <xacro:blueboat_thruster side="port" xyz="-0.488 0.295 -0.272"/>
  <xacro:blueboat_thruster side="stbd" xyz="-0.488 -0.295 -0.272"/>

  <!-- ===================== Accessories (from config) ===================== -->
  <xacro:mount_accessories items="${cfg.get('accessories') or []}"/>

  <!-- ===================== Batteries (from config) ===================== -->
  <xacro:mount_batteries items="${battery_items}" db="${battery_db}"/>

</robot>
