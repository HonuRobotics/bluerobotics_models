<?xml version="1.0"?>
<!--
  BlueBoat unmanned surface vessel, assembled from bluerobotics_parts.

  Everything about the vehicle comes from the config (which parts, where) and
  from the part macros (geometry, inertia). Displacement is a simulator
  concern: blueboat_gazebo declares it from the same config (docs:
  design/buoyancy). No Gazebo tags or plugins here.

      xacro blueboat.urdf.xacro > blueboat.urdf                     # default loadout
      xacro blueboat.urdf.xacro config_file:=/path/my_loadout.yaml  # custom
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="blueboat">

  <xacro:include filename="$(find bluerobotics_parts)/urdf/assembly.xacro"/>

  <!-- Config file: REMAP'd to the source config at build time; the default is
       the installed copy for manual/runtime use. -->
  <xacro:arg name="config_file"
             default="$(find blueboat_description)/config/blueboat.yaml"/>
  <xacro:property name="cfg" value="${xacro.load_yaml('$(arg config_file)')}"/>

  <!-- Chassis as the root; its slots (and theirs) fill with their defaults,
       the config overrides and adds. -->
  <xacro:assemble base="${cfg['base']}" parts="${cfg.get('parts') or []}"
                  slots="${cfg.get('slots') or []}"/>

</robot>
