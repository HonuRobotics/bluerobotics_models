<?xml version="1.0"?>
<!--
  Reusable outboard-motor / propeller macro for the BlueBoat.

  Each driven propeller is a link carrying the prop mesh, attached to the hull
  by a continuous joint spinning about the propeller axis. The static motor
  housings are part of the base_link visuals. Pose values reproduce the
  reference BlueBoat layout (ArduPilot SITL_Models blueboat model).
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    side    "port" or "stbd" (names the link/joint and selects the prop mesh)
    xyz     pose of the motor link relative to the parent link
    parent  link the motor is mounted on
  -->
  <xacro:macro name="blueboat_thruster" params="side xyz parent:=base_link">
    <link name="motor_${side}_link">
      <inertial>
        <!-- T200 in air ~0.344 kg; short-cylinder inertia (r~38 mm, h~40 mm).
             Note izz <= ixx + iyy must hold or sdformat rejects the link. -->
        <mass value="${thruster_mass}"/>
        <inertia ixx="1.7e-4" ixy="0.0" ixz="0.0"
                 iyy="1.7e-4" iyz="0.0" izz="2.5e-4"/>
      </inertial>
      <visual>
        <geometry><cylinder radius="0.04" length="0.02"/></geometry>
        <material name="prop_mat"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
    </link>

    <joint name="motor_${side}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="motor_${side}_link"/>
      <!-- rpy = (-90, 0, 90) degrees, matching the reference model. -->
      <origin xyz="${xyz}" rpy="-1.570796 0 1.570796"/>
      <axis xyz="0 0 -1"/>
    </joint>
  </xacro:macro>

</robot>
