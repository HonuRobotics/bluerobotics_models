<?xml version="1.0"?>
<!--
  Visualize the parts driven BlueBoat in RViz: robot_state_publisher on the
  URDF expanded from blueboat_parts.urdf.xacro, joint_state_publisher_gui
  (sliders to spin the propellers) and RViz with the packaged config. Pure
  ROS/description, no Gazebo. The mount sockets show up as TF frames named
  <parent>_<socket>.

      ros2 launch blueboat_description display_parts.launch.xml
      ros2 launch blueboat_description display_parts.launch.xml config_file:=/path/my_loadout.yaml
-->
<launch>
  <arg name="gui" default="true"
       description="Start joint_state_publisher_gui to drive the joints."/>
  <arg name="config_file"
       default="$(find-pkg-share blueboat_description)/config/blueboat_parts.yaml"
       description="Parts config (base part, parts list, hull displacement)."/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher"
        name="robot_state_publisher">
    <param name="robot_description"
           value="$(command 'xacro $(find-pkg-share blueboat_description)/urdf/blueboat_parts.urdf.xacro config_file:=$(var config_file)')"
           type="str"/>
  </node>

  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui"
        name="joint_state_publisher_gui" if="$(var gui)"/>

  <node pkg="rviz2" exec="rviz2" name="rviz2"
        args="-d $(find-pkg-share blueboat_description)/rviz/blueboat.rviz"/>
</launch>
