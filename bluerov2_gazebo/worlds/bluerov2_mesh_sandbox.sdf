<?xml version="1.0"?>
<!--
  Static mesh sandbox for the BlueROV2. Every mesh shipped by
  bluerov2_description, laid out in a row so they can be eyeballed side by
  side. No physics of interest, no buoyancy, no sensors - everything is
  <static> and nothing moves.

  Each <model> is named after its mesh FILE (extension stripped), so the entity
  tree reads as a file listing and you can tell immediately which asset you are
  looking at.

  Layout: one row, 1 m apart, all lifted to z = 0.1.
    hull (standard), hull (heavy), ping360, ccw prop, cw prop

  Lighting matches vrx_gazebo/worlds/open_water.sdf - cyan ambient, procedural
  sky, attenuated sun - so the meshes are judged under the light they will
  actually be seen in, minus the water. The GUI grid is deliberately left ON
  (open_water disables it) because it is the 1 m scale reference here.

  What this is for:
    scale       - the GUI grid is 1 m. The standard hull footprint is
                  0.457 x 0.338 m, the heavy 0.457 x 0.575 m.
    origin      - every model is placed at exactly z = 0.1 above a reference
                  plane at z = 0, so the expected gap is a uniform 10 cm. A
                  mesh sitting at a different height, or clipping the plane,
                  has an origin that is not on its base.
    orientation - +X is to the right along the row; the vehicle nose should
                  face +X.
    props       - ccw_prop and cw_prop are the counter-rotating pair. They
                  should be mirror images of each other; if they look
                  identical, one of them is the wrong file.
    materials   - bear in mind the cyan ambient tints everything, so judge
                  material presence rather than exact colour.

  Requires bluerov2_description built and sourced - the meshes resolve via
  GZ_SIM_RESOURCE_PATH, populated by that package's environment hook.

  Run it directly, no ROS:  gz sim <this file>
-->
<sdf version="1.12">
  <world name="bluerov2_mesh_sandbox">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Ocean-like scene, matching open_water.sdf: deep-water ambient and the
         built-in procedural sky. Grid left enabled as the scale reference. -->
    <scene>
      <ambient>0.0 1.0 1.0</ambient>
      <background>0.0 0.7 0.8</background>
      <sky></sky>
      <grid>true</grid>
    </scene>

    <!-- Directional light (sun, attenuated by water), from open_water.sdf. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Reference plane at z = 0. Models sit 10 cm above it, so anything not
         showing that uniform gap has an origin that is not on its base. -->
    <model name="reference_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>10 6</size></plane>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bluerov2">
      <static>true</static>
      <pose>0 0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh><uri>model://bluerov2_description/meshes/bluerov2.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="bluerov2_heavy">
      <static>true</static>
      <pose>1 0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh><uri>model://bluerov2_description/meshes/bluerov2_heavy.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="ping360">
      <static>true</static>
      <pose>2 0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh><uri>model://bluerov2_description/meshes/accessories/ping360.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="ccw_prop">
      <static>true</static>
      <pose>3 0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh><uri>model://bluerov2_description/meshes/t200/ccw_prop.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="cw_prop">
      <static>true</static>
      <pose>4 0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh><uri>model://bluerov2_description/meshes/t200/cw_prop.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
