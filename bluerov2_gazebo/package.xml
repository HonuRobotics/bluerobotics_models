<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluerov2_gazebo</name>
  <version>0.1.0</version>
  <description>
    Gazebo Sim bring-up for the BlueROV2: the composed simulation model
    (thrusters, hydrodynamics, sensors, claw controllers), a self-contained
    underwater world, a sim launch file and the generated ros_gz bridge
    configuration. Gazebo-specific assets and plugins live here, keeping
    bluerov2_description free of simulator code.
  </description>
  <maintainer email="caguero@honurobotics.com">Carlos Agüero</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/HonuRobotics/bluerobotics_models</url>
  <url type="bugtracker">https://github.com/HonuRobotics/bluerobotics_models/issues</url>
  <author email="caguero@honurobotics.com">Carlos Agüero</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>xacro</buildtool_depend>
  <!-- build/test-time: scripts/generate_bridge_config.py emits the bridge yaml -->
  <depend>python3-yaml</depend>

  <!-- build-time too: model.sdf.xacro reads bluerov2_description's config via $(find) -->
  <depend>bluerov2_description</depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- ROS msg types the bridge maps the sensors + claw commands to -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>marine_acoustic_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
