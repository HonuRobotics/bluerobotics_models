<?xml version="1.0"?>
<!--
  Bring up Gazebo with the BlueROV2.

  Everything about the vehicle is derived from config_file at launch time by
  configure_vehicle.py (URDF, composed model, ros_gz bridge config, into a
  per config directory under $ROS_HOME), so a custom config needs no
  rebuild and works the same from a source build or a binary install. A
  config that does not match the parts (a slot that does not exist, a type
  that does not fit) fails the launch with the reason. The world is vehicle free
  (bluerov2_pool.sdf by default, the same pool scene the playground
  world shows) and the generated model is spawned into it
  as "bluerov2". With use_composition (default), gz_server, the bridge and
  robot_state_publisher run as composable nodes in ONE container process;
  the Gazebo GUI runs as a separate process. The simulation starts running and the
  vehicle settles at its declared trim.

      ros2 launch bluerov2_gazebo sim.launch.xml
      ros2 launch bluerov2_gazebo sim.launch.xml config_file:=/path/my_vehicle.yaml
-->
<launch>
  <arg name="world"
       default="$(find-pkg-share bluerov2_gazebo)/worlds/bluerov2_pool.sdf"
       description="Vehicle free world SDF to spawn the vehicle into."/>
  <arg name="use_composition" default="true"
       description="Run gz_server, bridge and robot_state_publisher in one process."/>
  <arg name="gui" default="true" description="Launch the Gazebo GUI."/>
  <arg name="config_file"
       default="$(find-pkg-share bluerov2_description)/config/bluerov2.yaml"
       description="Vehicle vehicle config, expanded at launch."/>
  <arg name="name" default="bluerov2"
       description="Model name to spawn as; the world's buoyancy enable expects bluerov2."/>
  <arg name="z" default="0.5" description="Spawn height (m); the vehicle drops in and settles."/>

  <!-- Every artifact of this configuration, generated now from config_file. -->
  <let name="vehicle_dir"
       value="$(command '$(find-pkg-prefix bluerov2_gazebo)/lib/bluerov2_gazebo/configure_vehicle.py --config $(var config_file) --cache')"/>

  <!-- Gazebo server (composable) — creates the shared container. -->
  <gz_server world_sdf_file="$(var world)"
             container_name="ros_gz_container"
             create_own_container="true"
             use_composition="$(var use_composition)"/>

  <!-- Gazebo GUI (separate Qt process). -->
  <executable cmd="gz sim -g" output="screen" if="$(var gui)"/>

  <!-- The vehicle, spawned from the generated model into the (only) world. -->
  <node pkg="ros_gz_sim" exec="create" name="spawn_bluerov2" output="screen"
        args="-name $(var name) -z $(var z) -file $(var vehicle_dir)/model.sdf"/>

  <!-- ros_gz bridge (composable) — joins the container; bridges the clock. -->
  <ros_gz_bridge bridge_name="ros_gz_bridge"
                 config_file="$(var vehicle_dir)/ros_gz_bridge.yaml"
                 container_name="ros_gz_container"
                 create_own_container="false"
                 use_composition="$(var use_composition)"/>

  <!-- robot_state_publisher: composable node in the container when composing... -->
  <load_composable_node target="ros_gz_container" if="$(var use_composition)">
    <composable_node pkg="robot_state_publisher"
                     plugin="robot_state_publisher::RobotStatePublisher"
                     name="robot_state_publisher">
      <param from="$(var vehicle_dir)/robot_description.yaml"/>
      <param name="use_sim_time" value="true" type="bool"/>
    </composable_node>
  </load_composable_node>

  <!-- ...or a plain node when composition is disabled. -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher"
        name="robot_state_publisher" unless="$(var use_composition)">
    <param from="$(var vehicle_dir)/robot_description.yaml"/>
    <param name="use_sim_time" value="true"/>
  </node>
</launch>
