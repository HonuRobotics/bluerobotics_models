<?xml version="1.0"?>
<model>
  <name>BlueROV2</name>
  <version>1.0</version>
  <sdf version="1.12">model.sdf</sdf>

  <author>
    <name>Carlos Agüero</name>
    <email>caguero@honurobotics.com</email>
  </author>

  <description>
    Simulation-ready BlueROV2: merges the bluerov2_description base model and is
    where the Gazebo plugins live. A world can pull it in via
    model://bluerov2_gazebo, or it can be spawned at runtime with ros_gz_sim
    create. Meshes are temporary placeholders (see bluerov2_description/ASSETS.md).
  </description>
</model>
