<?xml version="1.0"?>
<!--
  Simulation ready BlueROV2 model, GENERATED from config/bluerov2.yaml at
  generation time (the base type selects the standard or heavy chassis). It
  merge includes the bluerov2_description geometry (assembled from
  bluerobotics_parts) and adds the Gazebo plugins: hydrodynamics, one
  Thruster per propeller part, one <sensor> per sensor part and the claw
  controllers, all placed by the same assembly resolution the URDF went
  through. Buoyancy is a world plugin acting on the dedicated
  buoyancy_displacement link below, solved from the config's declaration
  and the assembled mass (passed in as args by generate_model.py; docs:
  design/buoyancy).

  In a world:  <include><uri>model://bluerov2</uri></include>
-->
<sdf version="1.12" xmlns:xacro="http://ros.org/wiki/xacro"
     xmlns:gz="http://gazebosim.org/schema">

  <!-- The assembly dispatcher, run here with Gazebo side emitters. -->
  <xacro:include filename="$(find bluerobotics_parts)/urdf/assembly.xacro"/>

  <xacro:arg name="config_file"
             default="$(find bluerov2_description)/config/bluerov2.yaml"/>
  <xacro:property name="cfg" value="${xacro.load_yaml('$(arg config_file)')}"/>
  <!-- The URDF to merge: the Gazebo flavoured expansion (gltf_up:=z, glTF
       visuals pre-rotated because Gazebo does not convert the glTF up axis)
       installed next to this model, or (configure_vehicle.py, launch time
       loadouts) a file:// URI of one generated from the same config. -->
  <xacro:arg name="urdf_uri" default="model://bluerov2/bluerov2.urdf"/>
  <!-- Assembled mass properties, computed FROM the generated URDF by
       generate_model.py and needed by the buoyancy solve below. xacro
       cannot read the URDF itself, so generating this file by hand without
       them fails loudly rather than floating wrong. -->
  <xacro:arg name="total_mass" default=""/>
  <xacro:arg name="com" default=""/>

  <!-- Topic namespace: every part topic is /<topic_namespace>/<part name>/...
       on both sides (a camera's /image, a claw's /cmd_pos). Per part,
       `gz_topic` / `topic` override the gz side base; the bridge config is
       generated from the same yaml, so gz and ROS sides stay in sync. -->
  <xacro:property name="topic_ns" value="${cfg.get('topic_namespace', 'bluerov2')}"/>
  <!-- The root link the assembly names (the config's base.name). -->
  <xacro:property name="base_name" value="${cfg['base'].get('name', 'base_link')}"/>

  <!-- Config entry that fitted an instance, or {} (slot entries default
       their name to the slot). -->
  <xacro:macro name="part_entry" params="name">
    <xacro:property name="ovr"
                    value="${[e for e in (cfg.get('parts') or []) if e.get('name', e.get('slot')) == name]}"/>
    <xacro:property name="entry" scope="parent" value="${ovr[0] if ovr else dict()}"/>
  </xacro:macro>


  <!-- A propeller part drives its mounting joint: one Thruster plugin per
       propeller instance, with the limits the part declares in its `drive`
       table (the T200 endpoints). ccw props take +coeff, cw props -coeff so
       the reaction torques balance. Thrust commands (N) on
       <topic_base>/thrust, speed feedback on <topic_base>/thrust/ang_vel:
       the plugin prefixes a custom <topic> with its <namespace> (the model
       name unless given), so the namespace is emptied and the topic follows
       the config like every other part topic, not the spawn name. -->
  <xacro:macro name="prop_thruster" params="name drive topic_base">
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>${name}_joint</joint_name>
      <namespace></namespace>
      <topic>${topic_base}/thrust</topic>
      <thrust_coefficient>${0.02 if drive['rotation'] == 'ccw' else -0.02}</thrust_coefficient>
      <fluid_density>1025.0</fluid_density>
      <propeller_diameter>${drive['diameter']}</propeller_diameter>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>${drive['max_thrust']}</max_thrust_cmd>
      <min_thrust_cmd>${drive['min_thrust']}</min_thrust_cmd>
    </plugin>
  </xacro:macro>

  <!-- ===================== Sensors (config-driven) =====================
       One <sensor> per sensor-type accessory, emitted as a near-massless link
       fixed to base_link at the accessory's config pose (so the description stays
       Gazebo-free). The world must load gz-sim-sensors-system, plus
       gz-sim-dvl-system for the DVL. NOTE: gz sensor axes follow the link frame -
       a camera looks +X, a gpu_lidar scans the sensor XY plane, DVL beams point
       down per <tilt>; tune each accessory's rpy for the intended view.

       FRAMES. Every sensor pins <frame_id> to a link the DESCRIPTION defines,
       because that is the only name TF carries: robot_state_publisher publishes
       the URDF's links, while the ${name}_sensor wrapper links below exist only
       here. Left unset, gz derives the id from the SDF ('bluerov2/camera_sensor/
       camera'), which is in neither the URDF nor TF, so a consumer doing
       lookup_transform(base_link, msg.header.frame_id) simply fails.

       Every sensor uses its accessory's own link, i.e. the BODY frame (x
       forward, y left, z up). That matches what gz emits for the geometry
       topics - measured, not assumed: an rgbd_camera facing a wall 2.95 m ahead
       returns points at x=2.95, not z=2.95, so its cloud is body-framed and
       tagging it otherwise would rotate it 90 degrees in RViz.

       The cameras are the caveat. REP-145 says image/camera_info should carry an
       OPTICAL frame (z forward, x right, y down), and this model deliberately
       does not define one: consumers that unproject pixels (image_pipeline,
       RViz's Camera display) must apply the optical rotation themselves, i.e.
       rpy = (-pi/2, 0, -pi/2) relative to the link frame. -->

  <!-- Wrapper: a near-massless sensor link fixed to base_link at `pose`, holding
       the <sensor> block passed in. The accessory's real mass/geometry already
       live in base_link via the description; at 1e-5 kg a full sensor loadout
       stays orders of magnitude under the default 0.002 kg net_buoyancy, so
       the wrappers cannot tip the trim negative. -->
  <xacro:macro name="sensor_link" params="name frame *sensor">
    <link name="${name}_sensor">
      <!-- Posed at the part's own frame: the URDF conversion lumps the part
           into the root link but keeps every link as a frame by name, so
           the sensor follows the part wherever the config mounted it. -->
      <pose relative_to="${frame}">0 0 0 0 0 0</pose>
      <inertial>
        <mass>1e-5</mass>
        <inertia>
          <ixx>1e-8</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-8</iyy><iyz>0</iyz><izz>1e-8</izz>
        </inertia>
      </inertial>
      <xacro:insert_block name="sensor"/>
    </link>
    <joint name="${name}_sensor_joint" type="fixed">
      <parent>${base_name}</parent>
      <child>${name}_sensor</child>
    </joint>
  </xacro:macro>

  <!-- exploreHD USB HD camera. -->
  <xacro:macro name="camera_sensor" params="name frame topic_base">
    <xacro:sensor_link name="${name}" frame="${frame}">
      <sensor name="${name}" type="camera">
        <!-- Body frame; see the FRAMES note above on the optical convention. -->
        <frame_id>${name}</frame_id>
        <topic>${topic_base}/image</topic>
        <update_rate>20</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <camera>
          <camera_info_topic>${topic_base}/camera_info</camera_info_topic>
          <horizontal_fov>1.396</horizontal_fov>       <!-- ~80 deg -->
          <image><width>1920</width><height>1080</height></image>
          <clip><near>0.05</near><far>300</far></clip>
          <!-- GZ_VISIBILITY_ALL (0x0FFFFFFF): the all-ones default trips an
               ogre2 warning about its reserved high bits; same behaviour. -->
          <visibility_mask>268435455</visibility_mask>
        </camera>
      </sensor>
    </xacro:sensor_link>
  </xacro:macro>

  <!-- MarineSitu C3 stereo camera, modelled as an RGBD sensor (rgb + depth +
       points); swap to two <camera>s at the 7.5 cm baseline for a true pair. -->
  <xacro:macro name="rgbd_sensor" params="name frame topic_base">
    <xacro:sensor_link name="${name}" frame="${frame}">
      <sensor name="${name}" type="rgbd_camera">
        <frame_id>${name}</frame_id>
        <topic>${topic_base}</topic>
        <update_rate>15</update_rate>
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image><width>1280</width><height>720</height></image>
          <clip><near>0.1</near><far>20</far></clip>
          <!-- GZ_VISIBILITY_ALL, as above. -->
          <visibility_mask>268435455</visibility_mask>
        </camera>
      </sensor>
    </xacro:sensor_link>
  </xacro:macro>

  <!-- Ping360 scanning imaging sonar, APPROXIMATED by a 360-deg gpu_lidar sweep
       (geometry/range only, no acoustics). Real Ping360 range ~0.75-50 m. -->
  <xacro:macro name="ping360_sensor" params="name frame topic_base">
    <xacro:sensor_link name="${name}" frame="${frame}">
      <sensor name="${name}" type="gpu_lidar">
        <frame_id>${name}</frame_id>
        <topic>${topic_base}/scan</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal><samples>400</samples><resolution>1</resolution>
              <min_angle>-3.141593</min_angle><max_angle>3.141593</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.75</min><max>50</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </xacro:sensor_link>
  </xacro:macro>

  <!-- Water Linked DVL-A50: native DopplerVelocityLog custom sensor, 4-beam Janus
       (tilt 22.5 deg). Publishes gz.msgs.DVLVelocityTracking, bridged to
       marine_acoustic_msgs/msg/Dvl by ros_gz_bridge. Its backend system
       (gz-sim-dvl-system) is emitted with the model, ONLY when a DVL is
       fitted: loaded unconditionally, the idle backend joins every render
       iteration once any rendering sensor exists and costs half or more of
       the real time factor. -->
  <xacro:macro name="dvl_sensor" params="name frame topic_base">
    <xacro:sensor_link name="${name}" frame="${frame}">
      <sensor name="${name}" type="custom" gz:type="dvl">
        <frame_id>${name}</frame_id>
        <topic>${topic_base}/velocity</topic>
        <update_rate>8</update_rate>
        <always_on>1</always_on>
        <gz:dvl>
          <type>phased_array</type>
          <arrangement degrees="true">
            <beam id="1"><aperture>2</aperture><rotation>45</rotation><tilt>22.5</tilt></beam>
            <beam><aperture>2</aperture><rotation>135</rotation><tilt>22.5</tilt></beam>
            <beam><aperture>2</aperture><rotation>-45</rotation><tilt>22.5</tilt></beam>
            <beam><aperture>2</aperture><rotation>-135</rotation><tilt>22.5</tilt></beam>
          </arrangement>
          <tracking>
            <bottom_mode>
              <when>best</when>
              <noise type="gaussian"><stddev>0.002</stddev></noise>
              <visualize>false</visualize>
            </bottom_mode>
          </tracking>
          <resolution>0.01</resolution>
          <maximum_range>50.0</maximum_range>
          <minimum_range>0.1</minimum_range>
          <reference_frame>0 0 0 0 0 -1.570796</reference_frame>
        </gz:dvl>
      </sensor>
    </xacro:sensor_link>
  </xacro:macro>

  <!-- Emitters for the assembly dispatcher. Per resolved part instance: a
       propeller (a part with a `drive` table) gets a Thruster on its joint,
       the sensor types get their <sensor>, the claws their controllers;
       geometry only parts (payload_skid, roof_rack) emit nothing here. Topic
       overrides come from the config entry that fitted the instance. Ad
       hoc slots are URDF frames; nothing to emit. -->
  <xacro:macro name="gz_part" params="ptype name parent xyz rpy collision joint axis info">
    <xacro:part_entry name="${name}"/>
    <xacro:property name="topic_base"
                    value="${entry.get('gz_topic', entry.get('topic', topic_ns + '/' + name))}"/>
    <!-- A propeller on a fixed joint (a spare, say) is lumped away and
         drives nothing. -->
    <xacro:if value="${'drive' in info and joint != 'fixed'}">
      <xacro:prop_thruster name="${name}" drive="${info['drive']}" topic_base="${topic_base}"/>
    </xacro:if>
    <xacro:if value="${ptype == 'explorehd_camera'}"><xacro:camera_sensor name="${name}" frame="${name}" topic_base="${topic_base}"/></xacro:if>
    <xacro:if value="${ptype == 'marinesitu_c3'}">   <xacro:rgbd_sensor    name="${name}" frame="${name}" topic_base="${topic_base}"/></xacro:if>
    <xacro:if value="${ptype == 'ping360'}">         <xacro:ping360_sensor name="${name}" frame="${name}" topic_base="${topic_base}"/></xacro:if>
    <xacro:if value="${ptype == 'dvl_a50'}">         <xacro:dvl_sensor     name="${name}" frame="${name}" topic_base="${topic_base}"/></xacro:if>
    <xacro:if value="${ptype == 'newton_gripper'}">  <xacro:claw_controller topic_base="${topic_base}" left_joint="${name}_jaw_left_joint" right_joint="${name}_jaw_right_joint"/></xacro:if>
    <xacro:if value="${ptype == 'sediment_sampler'}"><xacro:claw_controller topic_base="${topic_base}" left_joint="${name}_cup_left_joint" right_joint="${name}_cup_right_joint"/></xacro:if>
  </xacro:macro>
  <xacro:macro name="gz_no_slot" params="name parent xyz rpy:='0 0 0'">
  </xacro:macro>

  <!-- Claw actuation (gripper jaws / sampler cups): one JointPositionController per
       finger, both on the same command topic so a single gz.msgs.Double opens/
       closes both symmetrically (SDF <mimic> is unsupported on the default dartsim
       engine). Command an angle 0 (closed) .. 0.6 (open) on <topic_base>/cmd_pos. -->
  <xacro:macro name="claw_controller" params="topic_base left_joint right_joint">
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>${left_joint}</joint_name>
      <topic>${topic_base}/cmd_pos</topic>
      <p_gain>2.0</p_gain> <i_gain>0.05</i_gain> <d_gain>0.1</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>${right_joint}</joint_name>
      <topic>${topic_base}/cmd_pos</topic>
      <p_gain>2.0</p_gain> <i_gain>0.05</i_gain> <d_gain>0.1</d_gain>
    </plugin>
  </xacro:macro>

  <model name="bluerov2">
    <include merge="true">
      <uri>$(arg urdf_uri)</uri>
    </include>

    <!-- ===================== Buoyancy displacement =====================
       The config's buoyancy declaration realized as geometry: one analytic
       box on a dedicated link that the world's buoyancy plugin is enabled
       on (<enable>bluerov2::buoyancy_displacement</enable>), so the parts'
       own collisions are contact geometry and never displace. Solved here:
         fluid_density * volume = total_mass + net_buoyancy
       with the box centroid on the declared CoB (cob_offset from the CoM
       or from the root link). total_mass / com come from the assembled
       URDF via generate_model.py. Fixed jointed: physics sees one body. -->
    <xacro:property name="buoyancy_cfg" value="${cfg.get('buoyancy') or dict()}"/>
    <xacro:if value="${'$(arg total_mass)' == '' or '$(arg com)' == ''}">
      <xacro:assembly_fail message="model.sdf.xacro needs total_mass and com args; generate it with generate_model.py (the build and configure_vehicle.py do)"/>
    </xacro:if>
    <xacro:property name="total_mass" value="${float('$(arg total_mass)')}"/>
    <xacro:property name="com" value="${[float(v) for v in '$(arg com)'.split()]}"/>
    <xacro:property name="water_density" value="${float(buoyancy_cfg.get('fluid_density', 1025.0))}"/>
    <xacro:property name="net_buoyancy" value="${float(buoyancy_cfg.get('net_buoyancy', 0.002))}"/>
    <xacro:property name="cob_offset"
      value="${[float(v) for v in str(buoyancy_cfg.get('cob_offset', '0 0 0.046')).split()]}"/>
    <xacro:property name="cob_frame" value="${str(buoyancy_cfg.get('cob_frame', 'com'))}"/>
    <xacro:if value="${cob_frame not in ['com', 'base_link']}">
      <xacro:assembly_fail message="buoyancy cob_frame must be com or base_link, not '${cob_frame}'"/>
    </xacro:if>
    <xacro:property name="footprint"
      value="${[float(v) for v in str(buoyancy_cfg.get('footprint', '0.457 0.338')).split()]}"/>
    <xacro:property name="displaced_volume" value="${(total_mass + net_buoyancy) / water_density}"/>
    <xacro:property name="box_height" value="${displaced_volume / (footprint[0] * footprint[1])}"/>
    <xacro:property name="cob_target"
      value="${[(com[i] if cob_frame == 'com' else 0.0) + cob_offset[i] for i in [0, 1, 2]]}"/>
    <link name="buoyancy_displacement">
      <pose relative_to="${base_name}">0 0 0 0 0 0</pose>
      <inertial>
        <mass>1e-5</mass>
        <inertia>
          <ixx>1e-8</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-8</iyy><iyz>0</iyz><izz>1e-8</izz>
        </inertia>
      </inertial>
      <collision name="displacement">
        <pose>${cob_target[0]} ${cob_target[1]} ${cob_target[2]} 0 0 0</pose>
        <geometry>
          <box><size>${footprint[0]} ${footprint[1]} ${box_height}</size></box>
        </geometry>
      </collision>
    </link>
    <joint name="buoyancy_displacement_joint" type="fixed">
      <parent>${base_name}</parent>
      <child>buoyancy_displacement</child>
    </joint>

    <!-- Joint states for the propeller and claw joints, so
         robot_state_publisher can animate them in RViz. Bridged to
         /joint_states. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>${topic_ns}/joint_states</topic>
    </plugin>

    <!-- The DVL backend, ONLY when a DVL is fitted (see the dvl_sensor
         comment). One instance serves every DVL in the model. -->
    <xacro:if value="${len([e for e in (cfg.get('parts') or []) if e.get('type') == 'dvl_a50']) > 0}">
      <plugin filename="gz-sim-dvl-system"
              name="gz::sim::systems::DopplerVelocityLogSystem"/>
    </xacro:if>

    <!-- Hydrodynamic damping (Fossen quadratic drag, reference BlueROV2).
         Added mass (xDotU etc., e.g. von Benzon 2022) is intentionally left at
         zero: the plugin applies it as explicit acceleration feedback, which
         diverges when added mass exceeds rigid mass (heave: 18.68 vs 11.5 kg).
         The stable path is SDF <fluid_added_mass>, pending build time URDF
         conversion so base_link's inertial can carry it. -->
    <plugin filename="gz-sim-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
      <link_name>${base_name}</link_name>
      <water_density>1025.0</water_density>
      <xU>0</xU>   <yV>0</yV>   <zW>0</zW>
      <kP>0</kP>   <mQ>0</mQ>   <nR>0</nR>
      <xUabsU>-33.732</xUabsU>
      <yVabsV>-54.16</yVabsV>
      <zWabsW>-73.225</zWabsW>
      <kPabsP>-3.992</kPabsP>
      <mQabsQ>-3.992</mQabsQ>
      <nRabsR>-3.992</nRabsR>
    </plugin>

    <!-- Thrusters, sensors and claw controllers: one per matching part
         the assembly resolves to. No manifest: that lives in the merged
         URDF. -->
    <xacro:assemble base="${cfg['base']}" parts="${cfg.get('parts') or []}"
                    slots="${cfg.get('slots') or []}" emit="gz_part" emit_slot="gz_no_slot"
                    manifest="false"/>
  </model>
</sdf>
